---
import ThemeToggle from '@/components/site/theme-toggle/theme-toggle.astro'

interface Props {
  // The route names itself, so a reader arriving from a shared link knows
  // where they are rather than only how to leave.
  here: string
}

const { here } = Astro.props
---

{/* The stylesheet makes this bar sticky, so it is the way home for the whole
    scroll rather than the first 77px. Its column matches the one the landing
    page's bar uses, so the chrome holds its shape across a navigation even
    though the prose under it is a different width. */}
<header data-section="header" class="relative page-inset">
  {/* The same ground the landing bar renders, so a reader crossing between the
      two meets one bar. It contracts here on the reader's own scroll, which is
      the state a route can actually show: this bar sits at the top of the page
      from load, where the landing bar only arrives once the hero has gone. */}
  <div data-bar-ground aria-hidden="true"></div>
  {/* No rule under the bar, matching the landing page's. The blur behind it is
      what separates the chrome from the prose passing under it, and a line as
      well as a blur states the same boundary twice. */}
  <div
    data-bar-row
    class="relative mx-auto flex max-w-3xl items-center justify-between py-4"
  >
    <a
      href="/"
      data-way-home
      class="text-foreground text-label inline-flex min-h-11 items-center underline-offset-4 hover:underline"
    >
      Eric Le
    </a>
    {/* The name states where the reader is only once the page has stopped
        stating it. Both on screen together covers the first screen of every
        route, which is the duplication this closes. */}
    <span
      data-route-here
      class="text-muted-foreground text-label truncate px-4"
      aria-hidden="true">{here}</span
    >
    <ThemeToggle />
  </div>
</header>

<style>
  [data-route-here] {
    opacity: 0;
  }
  [data-route-here][data-shown='true'] {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-route-here] {
      transition: opacity 200ms ease-out;
    }
  }
</style>

<script>
  // The bar spans the width at the top of the route and contracts once the
  // reader is into the prose. A route shows both states, where the landing
  // page only ever arrives already scrolled.
  const CONDENSE_AFTER_PX = 240

  const routeBar = document.querySelector<HTMLElement>(
    'header[data-section="header"]',
  )
  if (routeBar) {
    let pending = false
    const readScroll = () => {
      pending = false
      if (window.scrollY > CONDENSE_AFTER_PX) {
        routeBar.setAttribute('data-condensed', 'true')
      } else {
        routeBar.removeAttribute('data-condensed')
      }
    }
    // Coalesced to a frame, since scroll fires per pixel of a drag.
    window.addEventListener(
      'scroll',
      () => {
        if (pending) return
        pending = true
        requestAnimationFrame(readScroll)
      },
      { passive: true },
    )
    readScroll()
  }

  const here = document.querySelector<HTMLElement>('[data-route-here]')
  const title = document.querySelector<HTMLElement>('main h1')
  const bar = document.querySelector<HTMLElement>('header[data-section="header"]')

  if (here && title && bar && 'IntersectionObserver' in window) {
    // The bar sits over the top of the page, so the title counts as gone once
    // it passes behind the bar rather than once it clears the viewport. Its own
    // box states how far that is, where a constant would restate a height the
    // padding and the control inside it already fix.
    const watchFromUnderTheBar = () => {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              here.removeAttribute('data-shown')
            } else {
              here.setAttribute('data-shown', 'true')
            }
          }
        },
        {
          threshold: 0,
          rootMargin: `-${Math.round(bar.getBoundingClientRect().height)}px 0px 0px 0px`,
        },
      )
      observer.observe(title)
    }

    // A module script does not wait for stylesheets, so the bar can report an
    // unstyled height here. Readiness is the guarantee it has its own.
    if (document.readyState === 'complete') watchFromUnderTheBar()
    else window.addEventListener('load', watchFromUnderTheBar, { once: true })
  } else if (here) {
    // Without an observer the name is the more useful of the two states, since
    // a reader deep in a route has no other answer to where they are.
    here.setAttribute('data-shown', 'true')
  }
</script>
