---
import annexPosterDark from '@/assets/projects/annex-dark.png'
import annexPoster from '@/assets/projects/annex-light.png'
import canonPosterDark from '@/assets/projects/canon-dark.png'
import canonPoster from '@/assets/projects/canon-light.png'
import caretPoster from '@/assets/projects/caret.png'
import frameboardPosterDark from '@/assets/projects/frameboard-dark.png'
import frameboardPoster from '@/assets/projects/frameboard-light.png'
import jobtriagePoster from '@/assets/projects/jobtriage.png'
import stackrPoster from '@/assets/projects/stackr.png'
import canonVideo from '@/assets/videos/canon.mp4?url'
import canonVideoLight from '@/assets/videos/canon-light.mp4?url'
import caretVideo from '@/assets/videos/caret.mp4?url'
import frameboardVideo from '@/assets/videos/frameboard.mp4?url'
import jobtriageVideo from '@/assets/videos/jobtriage.mp4?url'
import stackrVideo from '@/assets/videos/stackr.mp4?url'

import ProjectCard from './project-card.astro'

// Each card names the route it owns as its own field. It used to be derived by
// picking the one internal href out of the links list, which stopped working
// the moment the route stopped being a link in it. The links are now what they
// say they are: where the artifact itself lives.
const projects = [
  {
    name: 'canon',
    route: '/canon',
    description:
      'A CLI and Claude Code plugin that runs AI coding agents through plan, build and review the same way in every repository.',
    poster: canonPoster,
    posterDark: canonPosterDark,
    videoSrc: canonVideoLight,
    videoSrcDark: canonVideo,
    mediaAlt:
      'One change running through canon, from the groundwork that measured it through its plan, dispatch, build, and review to the merge',
    links: [
      { label: 'GitHub', href: 'https://github.com/erclx/canon' },
      { label: 'npm', href: 'https://www.npmjs.com/package/@erclx/canon' },
      { label: 'Live build', href: 'https://canon.erclx.dev' },
    ],
  },
  {
    name: 'Frameboard',
    route: '/frameboard',
    description:
      'A board where coding agents draw interfaces as plain HTML files.',
    // The board has one loop, recorded in light, so it plays under both
    // themes while the stills follow the theme.
    poster: frameboardPoster,
    posterDark: frameboardPosterDark,
    videoSrc: frameboardVideo,
    mediaAlt:
      "The Frameboard canvas showing a plant care app's landing page and two phone screens",
    links: [
      { label: 'GitHub', href: 'https://github.com/erclx/frameboard' },
      { label: 'npm', href: 'https://www.npmjs.com/package/frameboard' },
      { label: 'Website', href: 'https://frameboard.erclx.dev' },
    ],
  },
  {
    name: 'Stackr',
    route: '/stackr',
    description:
      'A VS Code extension that stages files across a workspace into one block of context for an AI chat.',
    poster: stackrPoster,
    videoSrc: stackrVideo,
    mediaAlt:
      'Stackr — VS Code panel showing staged files and a context preview',
    mediaPosition: 'left top',
    links: [
      {
        label: 'VS Code Marketplace',
        href: 'https://marketplace.visualstudio.com/items?itemName=erclx.ai-context-stacker',
      },
      {
        label: 'Open VSX',
        href: 'https://open-vsx.org/extension/erclx/ai-context-stacker',
      },
      { label: 'GitHub', href: 'https://github.com/erclx/stackr' },
    ],
  },
  {
    name: 'Caret',
    route: '/caret',
    description:
      'A Chrome extension that saves prompts and inserts them into Claude, Gemini and ChatGPT.',
    poster: caretPoster,
    videoSrc: caretVideo,
    mediaAlt:
      'Caret — chat input showing a trigger-character palette of saved prompts',
    links: [
      {
        label: 'Chrome Web Store',
        href: 'https://chromewebstore.google.com/detail/caret/bpmdbibldelkpncegllkeegdpblgehgk',
      },
      { label: 'GitHub', href: 'https://github.com/erclx/caret' },
    ],
  },
  {
    name: 'Jobtriage',
    route: '/jobtriage',
    description:
      "A job-search agent over Sweden's public job API that shows the ads that fit, each with a reason.",
    poster: jobtriagePoster,
    videoSrc: jobtriageVideo,
    mediaAlt:
      'Jobtriage, chat interface with retrieved ad cards on a React Flow canvas',
    links: [
      { label: 'Live demo', href: 'https://jobtriage.erclx.dev' },
      { label: 'GitHub', href: 'https://github.com/erclx/jobtriage' },
    ],
  },
  {
    name: 'annex',
    route: '/annex',
    description:
      'An agent that maps a described AI system to the EU AI Act articles that apply, cited to the text.',
    poster: annexPoster,
    posterDark: annexPosterDark,
    mediaAlt:
      'The Annex landing page: a description box and twelve recorded questions',
    links: [
      { label: 'Recorded demo', href: 'https://annex.erclx.dev' },
      { label: 'GitHub', href: 'https://github.com/erclx/annex' },
    ],
  },
]
---

<section
  id="projects"
  data-section="projects"
  class="page-inset py-16 md:py-20"
>
  <div class="mx-auto max-w-3xl lg:max-w-5xl">
    <h2
      data-fade
      class="font-display text-foreground section-heading mx-auto max-w-3xl leading-tight font-semibold"
    >
      Projects
    </h2>
    {
      /* The section opens straight onto the grid and closes on its last card.
        A route is reached by clicking a card's name. */
    }
    {
      /* The gutter carries the separation the plate used to. It also has to
        clear the halo a hover raises: at a 24px gutter the halo's own box
        reached the neighboring card exactly, and its shadow crossed about
        36px into it, so pointing at one card lit the one beside it. */
    }
    <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-2">
      {
        projects.map((project, index) => {
          const numeral = String(index + 1).padStart(2, '0')
          const isLeftCol = index % 2 === 0
          const fadeDelay = `${index * 200}ms`
          // An odd count leaves the last card alone in a two-column row, so it
          // closes the section across both columns instead.
          const isWide =
            projects.length % 2 === 1 && index === projects.length - 1
          return (
            <div
              data-project-frame
              class:list={['relative', isWide && 'lg:col-span-2']}
            >
              <span
                aria-hidden="true"
                data-fade
                style={`--fade-delay: ${fadeDelay}`}
                class:list={[
                  'font-display pointer-events-none absolute z-10 leading-none font-semibold select-none',
                  'dark:text-foreground/12 top-3 right-5 text-[5rem] text-stone-500/50',
                  'lg:dark:text-foreground/15 lg:top-0 lg:text-[8rem] lg:text-stone-500/65',
                  isLeftCol
                    ? 'lg:right-auto lg:-left-12'
                    : 'lg:-right-12 lg:left-auto',
                ]}
              >
                {numeral}
              </span>
              <ProjectCard
                name={project.name}
                description={project.description}
                poster={project.poster}
                posterDark={project.posterDark}
                videoSrc={project.videoSrc}
                videoSrcDark={project.videoSrcDark}
                mediaAlt={project.mediaAlt}
                mediaPosition={project.mediaPosition}
                links={project.links}
                caseStudyHref={project.route}
                index={index}
                isWide={isWide}
              />
            </div>
          )
        })
      }
    </div>
  </div>
</section>

<script>
  import { initHoverVideo } from '@/lib/hover-video'
  import { initReveal } from '@/lib/reveal'

  import { initTilt } from './tilt'

  initReveal()
  initHoverVideo()
  initTilt()
</script>
