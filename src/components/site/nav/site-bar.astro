---

{/* The flyer carries the name from the hero to the bar. It renders at the
    hero's own size and scales down as it travels, so it lands crisp at the size
    the bar holds. Hidden until the handoff script measures it, which keeps the
    no-JS path on the hero's real heading. */}
<span
  data-hero-flyer
  aria-hidden="true"
  class="font-display text-display text-foreground pointer-events-none fixed top-0 left-0 z-40 origin-top-left"
  style="visibility: hidden"
>
  Eric Le
</span>

{/* The single theme toggle rides here once the handoff promotes it, so one
    control serves the hero and the bar rather than two where only the first
    in the document is ever wired. */}
<div
  data-toggle-host
  class="fixed top-0 left-0 z-40"
  style="visibility: hidden"
>
</div>

{/* A thinner ground than the near-opaque one it carried, over a wider blur,
    and no rule under it. The bar held the page's ground while the hero, the
    lighter plate in both themes, was still behind it, so the one surface meant
    to carry a reader between the two announced the split instead.

    Both values are set by measurement, and they pull against each other.

    The fill answers contrast. The name is 14px medium, so it has to clear
    4.5:1. Blur with no fill at all blends best and measures 3.29:1 in the
    light theme over the projects grid, which is the busiest backdrop the bar
    crosses. This holds 5.02:1 there and 8.16:1 in dark, across five sampled
    scroll depths.

    The blur answers ghosting. Prose passing under a lightly tinted bar reads
    through it as letterforms, which is why the route bar's ground is
    near-opaque. Widening the blur destroys the letterforms while the backdrop
    still reads as a wash, so it buys the same fix without spending the whole
    translucency.

    Widening it further is not free: at 40px the radius averages in the dark
    gaps between project cards, which darkens the ground under near-black text
    and drops the light theme back to 4.35:1. The pair sits where the ghost is
    gone and the floor is cleared with room, rather than at either extreme. */}
<div data-site-bar class="fixed inset-x-0 top-0 z-30 page-inset">
  {/* The ground is its own element so it can contract into a detached shape
      while the row above it does not move. The hero flies its name and its
      theme toggle into the slots in that row at measured positions, and the
      architecture record carries three shipped defects from measuring against
      a bar that had not settled. A ground that changes shape under a fixed row
      adds no fourth: the slots are where they were at every scroll depth, and
      what moves is the thing nothing is measured against. */}
  <div data-bar-ground aria-hidden="true"></div>
    {/* The bar's contents sit in the same column the hero uses, on every
      surface, so the chrome never resizes when a reader moves between the
      landing page and a route. That also lands the name where it started, so
      the travel is vertical and nothing drifts sideways. */}
  <div
    data-bar-row
    class="relative mx-auto flex max-w-3xl items-center justify-between py-3"
  >
    {/* The slot is where the traveling name lands, and it is the control the
        landed name becomes. It renders its own text to hold the box and the
        type size the flyer scales to, and paints that text transparent because
        the flyer is the glyph a reader sees. In the hero the name is a heading
        and nothing else, so this only answers once the bar is revealed and the
        bar's `inert` lifts with it. */}
    <button
      type="button"
      data-bar-name-slot
      data-to-top
      class="text-foreground text-label inline-flex min-h-11 cursor-pointer items-center rounded-sm"
    >
      Eric Le
    </button>
    {/* The toggle the page renders is the hero's own, moved into the fixed
        host below once the handoff runs. This slot reserves the space it lands
        in so the bar's row never reflows when it arrives. */}
    <span data-bar-toggle-slot class="inline-block size-11" aria-hidden="true"
    ></span>
  </div>
</div>

<style>
  /* The bar arrives once the reader is into the content, matching the rail's
     own gate so the two never appear apart. */
  [data-site-bar] {
    opacity: 0;
    pointer-events: none;
  }
  [data-site-bar][data-revealed='true'] {
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-site-bar] {
      transition: opacity 200ms ease-out;
    }
  }
  /* The slot renders its text so it carries the right box, and hides it so the
     flyer is the only name on screen. Without motion the flyer never runs, so
     the slot is what the reader sees. */
  [data-bar-name-slot] {
    color: transparent;
  }
  /* The flyer is the glyph a reader sees and the slot beneath it is the hit
     area, so the affordance has to be moved onto the flyer by hand. Without
     this the name is a control that never reacts to the pointer over it. */
  [data-hero-flyer][data-hot='true'] {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-bar-name-slot] {
      color: var(--foreground);
    }
  }
</style>

<script>
  import { initHeroHandoff } from './hero-handoff'

  const bar = document.querySelector<HTMLElement>('[data-site-bar]')
  const hero = document.querySelector<HTMLElement>('[data-section="header"]')

  // The bar is inert until it arrives, so the name inside it never takes focus
  // while a reader is still in the hero and the control is not on screen.
  const setRevealed = (revealed: boolean) => {
    if (!bar) return
    if (revealed) {
      bar.setAttribute('data-revealed', 'true')
      bar.removeAttribute('inert')
    } else {
      bar.removeAttribute('data-revealed')
      bar.setAttribute('inert', '')
    }
  }

  const toTop = bar?.querySelector<HTMLElement>('[data-to-top]')
  const flyer = document.querySelector<HTMLElement>('[data-hero-flyer]')

  const setHot = (hot: boolean) => {
    if (!flyer) return
    if (hot) flyer.setAttribute('data-hot', 'true')
    else flyer.removeAttribute('data-hot')
  }

  toTop?.addEventListener('pointerenter', () => setHot(true))
  toTop?.addEventListener('pointerleave', () => setHot(false))
  toTop?.addEventListener('focus', () => setHot(true))
  toTop?.addEventListener('blur', () => setHot(false))

  toTop?.addEventListener('click', () => {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    window.scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' })

    // The fragment a timeline chip left behind names a project card the reader
    // is no longer at, and nothing else clears it: this control scrolls rather
    // than navigates, so the URL kept claiming a position the page had left.
    // Replaced rather than pushed, because the reader asked to go to the top
    // and not to add a step they would have to press back through twice.
    if (window.location.hash) {
      window.history.replaceState(
        null,
        '',
        window.location.pathname + window.location.search,
      )
    }
  })

  // Two things open the gate and the earlier one wins. The controls land before
  // the hero has half left the viewport, and between those two moments they sat
  // at the top of the screen over page content with no bar behind them, which
  // reads as a rendering fault rather than as chrome. Measured at 1280x800: the
  // toggle lands at 298 and the hero gate opened past 400.
  let byArrival = false
  let byHero = false
  const sync = () => setRevealed(byArrival || byHero)

  if (bar) {
    setRevealed(false)
    if (!hero) {
      setRevealed(true)
    } else if ('IntersectionObserver' in window) {
      // The gate is half the hero rather than half the viewport. Measured at
      // 390x844, a hero shorter than half the viewport clears a viewport-keyed
      // margin without being scrolled at all, which put the bar on screen
      // carrying the name while the reader was still looking at the hero
      // carrying it. Reading the ratio keys the same moment to the hero's own
      // height, so it holds at any viewport and needs nothing measured.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            byHero = entry.intersectionRatio < 0.5
            sync()
          }
        },
        { threshold: [0, 0.5] },
      )
      observer.observe(hero)
    } else {
      setRevealed(true)
    }
  }

  initHeroHandoff((arrived) => {
    byArrival = arrived
    sync()
  })

  // The bar arrives spanning the width and contracts once the reader is
  // properly into the page, so the shape states how far they have come rather
  // than only that chrome exists. The distance is past the hero rather than a
  // constant, so a tall viewport and a short one condense at the same point in
  // the reading rather than at the same pixel.
  const CONDENSE_AFTER_HERO_PX = 320

  if (bar) {
    let pending = false
    const readScroll = () => {
      pending = false
      const heroHeight = hero?.getBoundingClientRect().height ?? 0
      const past = window.scrollY - heroHeight
      if (past > CONDENSE_AFTER_HERO_PX) {
        bar.setAttribute('data-condensed', 'true')
      } else {
        bar.removeAttribute('data-condensed')
      }
    }
    // Coalesced to a frame, since a scroll listener fires per pixel of a drag
    // and this reads layout.
    const onScroll = () => {
      if (pending) return
      pending = true
      requestAnimationFrame(readScroll)
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    readScroll()
  }
</script>
