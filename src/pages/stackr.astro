---
import { getImage } from 'astro:assets'

import stackrPoster from '@/assets/projects/stackr.png'
import stackrDemo from '@/assets/videos/stackr.mp4?url'
import RouteFoot from '@/components/site/case-study/route-foot.astro'
import RouteBar from '@/components/site/nav/route-bar.astro'
import SectionNav from '@/components/site/section-nav/section-nav.astro'
import BaseLayout from '@/layouts/base.astro'
import { getLinkTargetAttributes } from '@/lib/links'

const artifactLinks = [
  {
    label: 'VS Code Marketplace',
    href: 'https://marketplace.visualstudio.com/items?itemName=erclx.ai-context-stacker',
  },
  {
    label: 'Open VSX',
    href: 'https://open-vsx.org/extension/erclx/ai-context-stacker',
  },
  { label: 'GitHub', href: 'https://github.com/erclx/stackr' },
]

// A `poster` attribute takes a URL rather than an image, so it reaches for the
// source file unless something derives the optimized one.
const demoPoster = await getImage({ src: stackrPoster, format: 'webp' })

// The route's opening leads the rail, per the note in `jobtriage.astro`.
const navItems = [
  { id: 'stackr', label: 'stackr' },
  { id: 'why-i-built-it', label: 'why i built it' },
  { id: 'how-it-works', label: 'how it works' },
  { id: 'what-it-shows', label: 'what it shows' },
]
---

<BaseLayout
  title="Stackr · Eric Le"
  description="A VS Code extension that keeps named sets of files and copies each into an AI chat as one block, with the tree on top. On the Marketplace and Open VSX."
  surface="case-study"
>
  <SectionNav items={navItems} instant />

  <RouteBar here="Stackr" />

  <main>
    <section id="stackr" class="page-inset pt-16 pb-12 md:pt-20 md:pb-16">
      <div class="prose-column mx-auto">
        <p
          data-fade
          class="text-muted-foreground text-label tracking-wide uppercase"
        >
          Project
        </p>
        <h1
          data-fade
          class="font-display text-foreground mt-4 text-[2.25rem] leading-tight font-semibold md:text-[2.75rem]"
        >
          Stackr
        </h1>
        <p data-fade class="text-muted-foreground text-lede mt-4">
          Stackr is a VS Code extension that keeps named sets of files and
          copies each one into an AI chat as a single block, with the directory
          tree on top.
        </p>
        <ul data-fade class="mt-6 flex flex-wrap gap-x-6">
          {
            artifactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...getLinkTargetAttributes(link.href)}
                  class="text-foreground text-label inline-flex min-h-11 min-w-11 items-center underline-offset-4 hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        {
          /* The demo closes the opening rather than interrupting it. It declares
            `view` so a phone, which cannot hover, plays it on screen. */
        }
        <figure
          data-media-host="view"
          data-fade
          class="figure-breakout bg-card border-border/60 mt-12 overflow-hidden rounded-lg border"
        >
          <video
            src={stackrDemo}
            poster={demoPoster.src}
            muted
            loop
            playsinline
            preload="none"
            data-media-video
            aria-label="Files staged from the VS Code explorer into a named track, then copied as a directory tree followed by their contents"
            class="block h-auto w-full"></video>
        </figure>
      </div>
    </section>

    <section id="why-i-built-it" class="page-inset py-16 md:py-20">
      <div class="prose-column mx-auto">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          why i built it
        </h2>
        <p data-fade class="text-foreground text-lede mt-6">
          I was building context for planning chats by opening files one at a
          time and pasting them in order. The context was the input, and putting
          it together was the slow part.
        </p>
      </div>
    </section>

    <section id="how-it-works" class="page-inset py-16 md:py-20">
      <div class="prose-column mx-auto">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          how it works
        </h2>
        <p data-fade class="text-foreground text-lede mt-6">
          Each piece of work gets its own named set of files, and I switch
          between sets with one keystroke. Copying a set gives the model the
          folder structure first and then the files, with a token count per file
          so I can see what is too big.
        </p>
      </div>
    </section>

    <section id="what-it-shows" class="page-inset py-16 md:py-20">
      <div class="prose-column mx-auto">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          what it shows
        </h2>
        <p data-fade class="text-foreground text-lede mt-6">
          It has no runtime dependencies, so nothing extra loads into someone
          else's editor, and its tests run on Ubuntu, macOS and Windows.
          Published on the VS Code Marketplace and Open VSX, and I still use it.
        </p>
      </div>
    </section>
  </main>

  <RouteFoot />

  <script>
    import { initWayHome } from '@/components/site/case-study/way-home'
    import { initHoverVideo } from '@/lib/hover-video'
    import { initReveal } from '@/lib/reveal'

    initReveal()
    initWayHome()
    initHoverVideo()
  </script>
</BaseLayout>
