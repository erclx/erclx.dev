---
import { getImage } from 'astro:assets'

import caretPoster from '@/assets/projects/caret.png'
import caretDemo from '@/assets/videos/caret.mp4?url'
import RouteFoot from '@/components/site/case-study/route-foot.astro'
import RouteBar from '@/components/site/nav/route-bar.astro'
import BaseLayout from '@/layouts/base.astro'
import { getLinkTargetAttributes } from '@/lib/links'

const artifactLinks = [
  {
    label: 'Chrome Web Store',
    href: 'https://chromewebstore.google.com/detail/caret/bpmdbibldelkpncegllkeegdpblgehgk',
  },
  { label: 'GitHub', href: 'https://github.com/erclx/caret' },
]

// A `poster` attribute takes a URL rather than an image, so it reaches for the
// source file unless something derives the optimized one.
const demoPoster = await getImage({ src: caretPoster, format: 'webp' })

// The sections the bar links, per the note in `jobtriage.astro`.
const navItems = [
  { id: 'why-i-built-it', label: 'why i built it' },
  { id: 'how-it-works', label: 'how it works' },
  { id: 'what-it-shows', label: 'what it shows' },
]
---

<BaseLayout
  title="Caret · Eric Le"
  description="A prompt palette that opens where the cursor already is, on three chat sites that each handle text differently. A Chrome extension."
  surface="case-study"
>
  <RouteBar here="Caret" items={navItems} />

  <main>
    <section id="caret" class="page-inset pt-16 pb-12 md:pt-20 md:pb-16">
      <div class="prose-column mx-auto">
        <p
          data-fade
          class="text-muted-foreground text-label tracking-wide uppercase"
        >
          Project
        </p>
        <h1
          data-fade
          class="font-display text-foreground mt-4 text-[2.25rem] leading-tight font-semibold md:text-[2.75rem]"
        >
          Caret
        </h1>
        <p data-fade class="text-muted-foreground text-lede mt-4">
          Caret is a Chrome extension that opens a searchable prompt library
          right where you type, in Claude, Gemini and ChatGPT.
        </p>
        <ul data-fade class="mt-6 flex flex-wrap gap-x-6">
          {
            artifactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...getLinkTargetAttributes(link.href)}
                  class="text-foreground text-label inline-flex min-h-11 min-w-11 items-center underline-offset-4 hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        {
          /* The demo closes the opening rather than interrupting it. It declares
            `view` so a phone, which cannot hover, plays it on screen. */
        }
        <figure
          data-media-host="view"
          data-fade
          class="figure-breakout bg-card border-border/60 mt-12 overflow-hidden rounded-lg border"
        >
          <video
            src={caretDemo}
            poster={demoPoster.src}
            muted
            loop
            playsinline
            preload="none"
            data-media-video
            aria-label="A trigger symbol typed in a chat input opening a prompt palette above the cursor, and the chosen prompt landing in the input"
            class="block h-auto w-full"></video>
        </figure>
      </div>
    </section>

    <section id="why-i-built-it" class="page-inset py-16 md:py-20">
      <div class="prose-column mx-auto">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          why i built it
        </h2>
        <p data-fade class="text-foreground text-lede mt-6">
          I was retyping the same instructions into three chat sites several
          times a day. None of them could save a prompt, and a prompt saved in
          one could not reach the other two.
        </p>
      </div>
    </section>

    <section id="how-it-works" class="page-inset py-16 md:py-20">
      <div class="prose-column mx-auto">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          how it works
        </h2>
        <p data-fade class="text-foreground text-lede mt-6">
          Typing a trigger symbol opens the library above the cursor. I search,
          pick a prompt with the keyboard, and it lands in the chat input. Each
          site handles text differently, so the extension inserts it in a way
          each site accepts.
        </p>
      </div>
    </section>

    <section id="what-it-shows" class="page-inset py-16 md:py-20">
      <div class="prose-column mx-auto">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          what it shows
        </h2>
        <p data-fade class="text-foreground text-lede mt-6">
          Published on the Chrome Web Store across four releases, and people use
          it there.
        </p>
      </div>
    </section>
  </main>

  <RouteFoot />

  <script>
    import { initWayHome } from '@/components/site/case-study/way-home'
    import { initHoverVideo } from '@/lib/hover-video'
    import { initReveal } from '@/lib/reveal'

    initReveal()
    initWayHome()
    initHoverVideo()
  </script>
</BaseLayout>
