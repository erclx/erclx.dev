---
import BaseLayout from '@/layouts/base.astro'
import About from '@/components/site/about/about.astro'
import Header from '@/components/site/header/header.astro'
import LookingFor from '@/components/site/looking-for/looking-for.astro'
import Experience from '@/components/site/experience/experience.astro'
import Projects from '@/components/site/projects/projects.astro'
import SectionNav from '@/components/site/section-nav/section-nav.astro'
import Footer from '@/components/site/footer/footer.astro'
---

{/* The card carries the claim and the description says what the claim covers,
    so the pair reads as one statement rather than as three. Naming an employer
    here made a role that ended in June 2025 the identity, where metadata says
    who someone is and the timeline below says where they have been. The
    credential is one click away and this is the most compressed surface the
    site owns. `Applied AI engineer` is the retired form, settled as
    `AI Engineer` on every surface upstream at 4517ee6. */}
<BaseLayout
  title="Eric Le · AI Engineer"
  description="Agents, the developer tooling around them, and the full-stack work of making either usable by someone else."
>
  <SectionNav />
  <main>
    <Header />
    <About />
    <Experience />
    <Projects />
    <LookingFor />
  </main>
  <Footer />
</BaseLayout>
