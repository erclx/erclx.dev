---
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/base.astro'
import RouteBar from '@/components/site/nav/route-bar.astro'
import SectionNav from '@/components/site/section-nav/section-nav.astro'
import FigureDialog from '@/components/site/figures/figure-dialog.astro'
import RouteFoot from '@/components/site/case-study/route-foot.astro'
import { getLinkTargetAttributes } from '@/lib/links'
import dictionPoster from '@/assets/projects/diction.png'
import baselines from '@/assets/projects/diction-baselines.png'
import separation from '@/assets/projects/diction-separation.png'
import thresholds from '@/assets/projects/diction-thresholds.png'
import verdicts from '@/assets/projects/diction-verdicts.png'
import fluency from '@/assets/projects/diction-fluency.png'
import gaze from '@/assets/projects/diction-gaze.png'

const artifactLinks = [
  { label: 'GitHub', href: 'https://github.com/erclx/diction' },
]

// The route's opening leads the rail, per the note in `jobtriage.astro`.
const navItems = [
  { id: 'diction', label: 'diction' },
  { id: 'problem', label: 'problem' },
  { id: 'data', label: 'data' },
  { id: 'fix', label: 'fix' },
  { id: 'holdout', label: 'holdout' },
  { id: 'beyond', label: 'beyond' },
]

const scores = [
  {
    score: 'Minimal-pair verdict',
    before: "The target sound's own native band",
    after: "The competing sound scored at the target's aligned frames",
  },
  {
    score: 'Fluency',
    before: '100 * (1 - pause ratio)',
    after: 'Four timing features fit against human fluency labels',
  },
  {
    score: 'Interview gaze',
    before: 'A 15-degree head-turn gate',
    after: 'A 7-degree gate, sitting in the measured gap between takes',
  },
]

const figureClass =
  'figure-breakout figure-plate bg-card mt-10 rounded-lg p-6 md:p-10'
const wideImageClass = 'w-full rounded-md'

/* A portrait chart takes a plate sized to itself rather than the column step a
   wide one breaks out to. The two were one plate until 2026-08-20, and a 0.70
   aspect cannot fill a width chosen for charts running 2.4 and wider: measured
   at 1280 the image used 40% of its plate, and at 1920 it used 29%, because
   the plate scaled with the viewport while the image was pinned at a flat
   32rem that read neither the plate nor the screen.

   Both halves move here. The plate follows its content, and the image takes a
   ceiling that scales, so the pair holds 86% fill at 1280 and at 1920 where it
   held 40% and 29%. The height ceiling is a viewport fraction rather than a
   length, since what bounds a tall figure is the screen it has to fit inside. */
const tallFigureClass =
  'figure-plate bg-card mx-auto mt-10 w-fit rounded-lg p-6 md:p-10'
const tallImageClass =
  'mx-auto max-h-[min(46rem,78vh)] w-auto rounded-md'
const captionClass = 'text-muted-foreground font-mono text-label mt-4'
const zoomTriggerClass = 'block w-full cursor-zoom-in rounded-md'
---

<BaseLayout
  title="diction · Eric Le"
  description="One global confidence cutoff flagged native speakers and passed swapped vowels. Per-sound calibration, measured on held-out speech."
  surface="case-study"
>
  <SectionNav items={navItems} instant />

  <RouteBar here="diction" />

  <main>
    <section id="diction" class="page-inset pt-16 pb-12 md:pt-20 md:pb-16">
      <div class="mx-auto prose-column">
        <p data-fade class="text-muted-foreground text-label tracking-wide uppercase">
          Project
        </p>
        <h1
          data-fade          class="font-display text-foreground mt-4 text-[2.25rem] leading-tight font-semibold md:text-[2.75rem]"
        >
          diction
        </h1>
        <p
          data-fade          class="text-muted-foreground text-lede mt-4"
        >
          A pronunciation trainer that scores each sound against what a native
          speaker actually sounds like, and reports how often it is wrong.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-3"
        >
          Local and offline. Nothing leaves the machine it runs on.
        </p>
        <ul
          data-fade          class="mt-6 flex flex-wrap gap-x-6"
        >
          {
            artifactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...getLinkTargetAttributes(link.href)}
                  class="text-foreground text-label inline-flex min-h-11 min-w-11 items-center underline-offset-4 hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        {/* The one route that opened straight into prose. Every other route
            carries a figure in its first section, three of them a clip and one
            a still, so this one read as the unfinished one rather than the
            deliberate one.

            It is the still the card already uses rather than a new asset, and
            it is a picture rather than a media host, because there is no clip
            of this project to host. Eager, since it is the first thing under
            the fold on arrival and a lazy load would leave the slot empty for
            the moment a reader is looking straight at it. */}
        <figure
          data-fade          class="figure-breakout bg-card border-border/60 mt-12 overflow-hidden rounded-lg border"
        >
          <Image
            src={dictionPoster}
            alt="The diction trainer scoring a spoken passage, each sound marked against what a native speaker actually sounds like"
            class="block h-auto w-full"
            loading="eager"
          />
        </figure>
      </div>
    </section>

    <section id="problem" class="page-inset py-16 md:py-20">
      <div class="mx-auto prose-column">
        <h2 data-fade class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl">
          problem
        </h2>
        <p
          data-fade          class="text-foreground text-lede mt-6"
        >
          I wanted to assess my own English rather than guess at it. The tools
          that do that are paid and closed, and building it myself meant
          running the speech models locally and seeing what they were doing.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          The drill told native speakers they were wrong. It played a word,
          listened to the reading, and flagged the sound when the acoustic
          model's confidence fell below <code class="font-mono">-5.0</code>. One
          number, applied to every sound in English.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          On real speech it failed in both directions at once. A native
          <code class="font-mono">th</code> came back flagged. A swapped vowel
          passed, so <em>ship</em> read for <em>sheep</em> and <em>wok</em> for
          <em>walk</em> cleared the bar. A single cutoff cannot tell a good
          sound from a bad one, and the reason is the whole finding.
        </p>
      </div>
    </section>

    <section id="data" class="page-inset py-16 md:py-20">
      <div class="mx-auto prose-column">
        <h2 data-fade class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl">
          data
        </h2>
        <p
          data-fade          class="text-foreground text-lede mt-6"
        >
          <a
            href="https://www.openslr.org/101/"
            {...getLinkTargetAttributes('https://www.openslr.org/101/')}
            class="text-accent underline underline-offset-[3px] decoration-[1px]"
          >speechocean762</a> supplies 5,000 English clips from non-native speakers,
          each phoneme scored 0 to 2 by five human experts. That per-sound score
          is the ground truth a threshold can be fit against, and the corpus is
          Apache-2.0, so it ships.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          <a
            href="https://huggingface.co/facebook/wav2vec2-xlsr-53-espeak-cv-ft"
            {...getLinkTargetAttributes(
              'https://huggingface.co/facebook/wav2vec2-xlsr-53-espeak-cv-ft',
            )}
            class="text-accent underline underline-offset-[3px] decoration-[1px] font-mono"
          >wav2vec2-xlsr-53-espeak-cv-ft</a> ran over 2,500 of those clips to read off its
          confidence in each sound, a measure called Goodness of Pronunciation.
          Transcription was skipped: the words being read are known in advance,
          so only the acoustic model has to run, which cut an hours-long sweep
          to minutes.
        </p>

        <figure data-fade class={tallFigureClass}>
          <button type="button" data-figure-zoom class={zoomTriggerClass}>
            <Image
              src={baselines}
              alt="Mean confidence per phoneme for clean and clearly-wrong readings, with the old global threshold marked far to the left of nearly every sound"
              class={tallImageClass}
            />
          </button>
          <figcaption class={captionClass}>
            every sound sits somewhere different
          </figcaption>
        </figure>

        <p
          data-fade          class="text-muted-foreground text-body mt-8"
        >
          A native <code class="font-mono">s</code> sits near perfect
          confidence. A native <code class="font-mono">th</code> averages
          <code class="font-mono">-2.6</code>, because the model is less certain
          about <code class="font-mono">th</code> even when a native speaker says it correctly. The clean and
          wrong readings separate for every sound, and each pair sits at its own
          place on the axis.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          The old <code class="font-mono">-5.0</code> line cuts none of it
          cleanly. It falls so far left that a mangled
          <code class="font-mono">th</code> still scores above it and passes,
          while it clips the low end of confident vowels and flags them.
          Different sounds do not share a baseline, so one vertical line was
          never going to work.
        </p>
      </div>
    </section>

    <section id="fix" class="page-inset py-16 md:py-20">
      <div class="mx-auto prose-column">
        <h2 data-fade class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl">
          fix
        </h2>
        <p
          data-fade          class="text-foreground text-lede mt-6"
        >
          The rule became per-sound. For each phoneme, take the mean and spread
          of its native confidence, then flag a reading only where it falls more
          than 1.6 standard deviations below that sound's own mean. The cut
          travels with the sound.
        </p>

        <figure data-fade class={tallFigureClass}>
          <button type="button" data-figure-zoom class={zoomTriggerClass}>
            <Image
              src={separation}
              alt="Separation measured as AUC for all 27 sounds, every bar clearing the 0.75 reliability gate"
              class={tallImageClass}
            />
          </button>
          <figcaption class={captionClass}>
            separation per sound, against the reliability gate
          </figcaption>
        </figure>

        <p
          data-fade          class="text-muted-foreground text-body mt-8"
        >
          All 27 sounds separate, from 0.83 to 0.98. A reliability gate backs
          the rule up: a sound whose confidence failed to separate clean from
          wrong would be held out of the verdict rather than guessed at. Every
          sound clears it today, and the gate is there for the next model.
        </p>

        <figure data-fade class={figureClass}>
          <button type="button" data-figure-zoom class={zoomTriggerClass}>
            <Image
              src={thresholds}
              alt="Confidence distributions for long-e, th and w, each calibrated threshold falling between the clean and the clearly-wrong readings"
              class={wideImageClass}
            />
          </button>
          <figcaption class={captionClass}>
            calibrated thresholds against the readings they separate
          </figcaption>
        </figure>

        <p
          data-fade          class="text-muted-foreground text-body mt-8"
        >
          One earlier read had written the long-e vowel off as hopeless, its
          clean and wrong clouds apparently on top of each other. That came from
          comparing clean speech against borderline speech. Set against
          clearly-wrong readings, long-e separates at 0.98, as cleanly as any
          consonant. What a measurement is compared against decides what it
          concludes.
        </p>
      </div>
    </section>

    <section id="holdout" class="page-inset py-16 md:py-20">
      <div class="mx-auto prose-column">
        <h2 data-fade class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl">
          holdout
        </h2>
        <p
          data-fade          class="text-foreground text-lede mt-6"
        >
          A rule fit to its own data proves nothing, so the thresholds were fit
          on one half of the corpus and measured on the other half, held out
          from start to finish.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          On unseen speech it false-flags native readings 7% of the time and
          catches 66% of genuinely wrong sounds. That operating point is
          deliberate. Nagging a correct speaker erodes trust faster than missing
          an error does, so the cut keeps false alarms low and accepts that a
          third of subtle errors slip past.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          It also fixes the two failures that started this. A native
          <code class="font-mono">th</code> sits at its own baseline and passes.
          A substituted vowel drops below its own line and flags.
        </p>
      </div>
    </section>

    <section id="beyond" class="page-inset py-16 md:py-20">
      <div class="mx-auto prose-column">
        <h2 data-fade class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl">
          beyond
        </h2>
        <p
          data-fade          class="text-foreground text-lede mt-6"
        >
          Calibrating one score set the pattern for every other score the tool
          presents.
        </p>

        <figure
          data-fade          class="figure-breakout bg-card mt-10 overflow-x-auto rounded-lg p-6 md:p-10"
        >
          <table class="font-mono text-label w-full min-w-[28rem]">
            <thead>
              <tr class="text-muted-foreground">
                <th class="text-left font-normal">score</th>
                <th class="text-left font-normal">what it was</th>
                <th class="text-left font-normal">what it is now</th>
              </tr>
            </thead>
            <tbody class="text-foreground">
              {
                scores.map((row) => (
                  <tr>
                    <td class="py-1 pr-4 align-top">{row.score}</td>
                    <td class="text-muted-foreground py-1 pr-4 align-top">
                      {row.before}
                    </td>
                    <td class="py-1 align-top">{row.after}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </figure>

        <figure data-fade class={figureClass}>
          <button type="button" data-figure-zoom class={zoomTriggerClass}>
            <Image
              src={verdicts}
              alt="Verdict errors before and after the competitor check, false passes dropping from 15 to 2 while false retries rise from 5 to 6"
              class={wideImageClass}
            />
          </button>
          <figcaption class={captionClass}>
            minimal-pair verdict errors, before and after
          </figcaption>
        </figure>

        <p
          data-fade          class="text-muted-foreground text-body mt-8"
        >
          The minimal-pair drill asks a different question from the one the
          phoneme flag was fit for: whether a reading was
          <code class="font-mono">θ</code> rather than
          <code class="font-mono">f</code>, not whether it was an acceptable
          <code class="font-mono">θ</code>. Scoring the competitor at the
          target's own frames cut wrong words accepted from 15 to 2 across 32
          pairs, and moved right words rejected from 5 to 6.
        </p>

        <figure data-fade class={figureClass}>
          <button type="button" data-figure-zoom class={zoomTriggerClass}>
            <Image
              src={fluency}
              alt="Predicted against human fluency on the held-out split, beside the long-pause-ratio distribution that collapses to zero on a read-aloud corpus"
              class={wideImageClass}
            />
          </button>
          <figcaption class={captionClass}>
            fluency against human judgment, and the feature that cannot be fit
          </figcaption>
        </figure>

        <p
          data-fade          class="text-muted-foreground text-body mt-8"
        >
          Fluency correlates with human judgment at 0.39 on held-out clips,
          matching its in-sample fit. That is real and modest, so the score
          reads as directional rather than as a grade. Two of its four features
          carry the result and the two pause features cannot be fit at all here,
          because a read-aloud corpus almost never hesitates. Those two stay
          reasoned rather than fitted, and the whole score is labeled for what
          it is.
        </p>

        <figure data-fade class={figureClass}>
          <button type="button" data-figure-zoom class={zoomTriggerClass}>
            <Image
              src={gaze}
              alt="Per-frame yaw for a lens-look against a screen-glance, beside the threshold sweep where separation falls to zero at the old 15-degree gate and reaches 51 points at the new 7-degree one"
              class={wideImageClass}
            />
          </button>
          <figcaption class={captionClass}>
            gaze yaw per frame, and the gate sweep behind the new threshold
          </figcaption>
        </figure>

        <p
          data-fade          class="text-muted-foreground text-body mt-8"
        >
          The interview gaze metric first read a lens-look and a screen-glance
          as identical, since both keep the head inside 15 degrees. The raw yaw
          separates them cleanly, at a median of +1.2 degrees against -7.3.
          Tightening the gate to 7 degrees recovers a 51-point separation. Two
          clips from one speaker is a separation check rather than a fit, and
          the threshold is a directional placeholder until more recordings
          arrive.
        </p>

        <p
          data-fade          class="text-foreground text-body mt-10"
        >
          The flag is trustworthy now. The composite accent and prosody scores
          are still labeled directional, and they stay that way until real
          recorded pairs validate them. Calibrating a score presented as truth
          is the hard part, and that part is done.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          The whole experiment lives beside the case study in the repository.
          <code class="font-mono">measure.py</code> runs the sweep,
          <code class="font-mono">analyze.py</code> fits the thresholds,
          <code class="font-mono">validate.py</code> checks them on held-out
          speech, and <code class="font-mono">plots.py</code> draws these
          figures. The models and the dataset cache on first download, so a
          re-run takes minutes.
        </p>
      </div>
    </section>

  </main>

  <RouteFoot />

  <FigureDialog />

  <script>
    import { initWayHome } from '@/components/site/case-study/way-home'
    import { initFigureZoom } from '@/components/site/figures/figure-zoom'
    import { initReveal } from '@/lib/reveal'

    initReveal()
    initFigureZoom()
    initWayHome()
  </script>
</BaseLayout>
