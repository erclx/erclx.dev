---
import { email, github, linkedin, resume } from '@/lib/contact'

// The three the hero opens with, plus the one destination that was reachable
// only after a full scroll. The resume is the highest-intent link on the page
// and it sat last on it, while three contact links floated the whole way.
//
// It renders nearest the resting mark rather than furthest from it, so the
// shortest travel from the control belongs to the destination most readers
// came for.
const links = [github, linkedin, email, resume]

// On the résumé route the dock's résumé link points at the page it sits on, so
// it says so rather than reading as a way somewhere else.
const here = Astro.url.pathname.replace(/\/$/, '')
---

{
  /* Bottom right, clear of the bar's controls at the top of the page.

    Reversed, so the control that stays put sits nearest the corner and the
    stack grows up out of it. Rendered in order it put the resting mark at the
    top of a group that is anchored to the bottom, so the one thing a reader
    sees at rest moved every time the stack opened. */
}
<div
  data-contact-dock
  class="fixed right-6 bottom-6 z-30 flex flex-col-reverse items-end gap-2"
>
  {
    /* Expands the stack where a pointer is not available. It carries the
      expanded state rather than the links carrying it, so a keyboard reaches
      the links through ordinary focus and never through this. */
  }
  <button
    type="button"
    data-dock-toggle
    data-dock-surface
    aria-expanded="false"
    aria-controls="contact-dock-links"
    class="text-muted-foreground hover:text-foreground inline-flex size-11 items-center justify-center rounded-full"
  >
    <span class="sr-only">Contact</span>
    {
      /* An at sign rather than an envelope. The envelope is one of the three
        destinations below, so the control that opens the set was drawn as one
        member of it. */
    }
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-5"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path>
    </svg>
  </button>

  <ul
    id="contact-dock-links"
    data-dock-links
    class="flex flex-col items-end gap-2"
  >
    {
      links.map((link) => (
        <li class="relative flex items-center justify-end">
          {/* The name a pointer asks for, since the stack is icons alone. It
              sits to the left because the dock is pinned to the right edge and
              a label on the other side would run off the viewport.

              Hidden from assistive technology: the link already carries this
              string as its accessible name, so exposing it twice would have a
              screen reader read every destination in the set twice over. */}
          <span
            data-dock-name
            data-dock-surface
            aria-hidden="true"
            class="text-label text-muted-foreground pointer-events-none absolute right-full mr-2 rounded-full px-3 py-1 whitespace-nowrap"
          >
            {link.label}
          </span>
          <a
            href={link.href}
            {...link.attributes}
            aria-label={link.label}
            aria-current={link.href === here ? 'page' : undefined}
            data-dock-surface
            class="text-muted-foreground hover:text-foreground inline-flex size-11 items-center justify-center rounded-full"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5"
              aria-hidden="true"
            >
              {link.paths.map((path) => (
                <path d={path} />
              ))}
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* The dock does not stand down over the footer. A route's foot carries the
     way home alone, so hiding the dock there would remove every contact at
     the moment a reader has finished reading, on a page whose job is hiring.

     Below `md` the page instead keeps the dock's own height and offset free
     under its last line, so at the end of a route the dock sits on empty
     ground rather than over the closing foot. */
  @media (width < 48rem) {
    :global(body:has([data-contact-dock])) {
      padding-bottom: calc(2.75rem + 1.5rem);
    }
  }

  /* The stack is what collapses, never the links themselves, so the set stays
     in the tab order at every size and a keyboard never meets a hidden set.

     Moved and faded but never scaled. A collapsed link keeps its box in the
     tab order, and scaling shrank that box below the phone tap minimum: the
     set measured 43px square mid-transition against a 44px floor. */
  [data-contact-dock] [data-dock-links] {
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }
  [data-contact-dock]:focus-within [data-dock-links],
  [data-contact-dock][data-open='true'] [data-dock-links] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  /* Everywhere except a true touch device. Touch leaves `:hover` stuck on the
     last thing tapped, so the tap that collapses the set held it open through
     this rule after the flag had been cleared and focus released.

     Excluding touch rather than requiring hover, because Playwright's Firefox
     answers `(hover: hover)` and `(pointer: fine)` both false and would lose
     the hover path entirely. A coarse pointer is the one capability only a real
     touch device reports, so it is what this can safely key on. */
  @media not all and (pointer: coarse) {
    [data-contact-dock]:hover [data-dock-links] {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }

  /* The name answers the one destination a reader is pointing at rather than
     every destination at once, which is what a stack of four labels would be. */
  [data-dock-name] {
    opacity: 0;
  }
  [data-dock-links] li:hover [data-dock-name],
  [data-dock-links] li:focus-within [data-dock-name] {
    opacity: 1;
  }

  /* The link to the page the reader is on holds the accent edge a pointer
     raises on the others, doubled to two pixels, so the mark is a heavier
     ring as well as a color and does not wait on a hover to show. */
  [data-dock-links] a[aria-current='page'] {
    color: var(--foreground);
    border-color: var(--accent);
    box-shadow:
      var(--floating-shadow),
      inset 0 0 0 1px var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-dock-links] {
      transition:
        opacity 200ms ease-out,
        transform 200ms ease-out;
    }
    [data-dock-name] {
      transition: opacity 150ms ease-out;
    }
  }
</style>

<script>
  const dock = document.querySelector<HTMLElement>('[data-contact-dock]')
  const toggle = dock?.querySelector<HTMLElement>('[data-dock-toggle]')

  if (dock) {
    // The sections sheet and its scrim sit over the dock in the top layer, so
    // a pointer cannot reach it while the sheet is open, but a tab past the
    // last link still could. Inert closes that path for as long as the scrim
    // dims the control.
    const menu = document.querySelector<HTMLElement>('[data-section-menu]')
    menu?.addEventListener('toggle', (event) => {
      dock.inert = (event as ToggleEvent).newState === 'open'
    })

    toggle?.addEventListener('click', (event) => {
      const wasOpen = dock.dataset.open === 'true'
      if (wasOpen) {
        delete dock.dataset.open
        // Unsetting the flag is not enough to close it. The control that just
        // collapsed the set still holds focus, and `:focus-within` keeps the
        // stack visible and clickable, so the set has to be released as well.
        // A keyboard activation reports no pointer detail and keeps its place,
        // since blurring there drops the reader at the top of the document on
        // their next tab and the set stays open under them either way.
        if ((event as PointerEvent).detail > 0) toggle.blur()
      } else {
        dock.dataset.open = 'true'
      }
      toggle.setAttribute(
        'aria-expanded',
        String(!wasOpen || dock.contains(document.activeElement)),
      )
    })

    // A pointer leaving closes what a tap opened, so the dock does not sit
    // open behind a reader who has moved on. Focus still inside keeps the set
    // open through `:focus-within`, so the state it reports stays true.
    dock.addEventListener('pointerleave', (event) => {
      // A mouse only. A touch pointer is destroyed once the finger lifts, which
      // fires this before the click that reads the state, so a tap cleared the
      // flag it was about to toggle and the control could only ever open.
      if ((event as PointerEvent).pointerType !== 'mouse') return
      delete dock.dataset.open
      if (dock.contains(document.activeElement)) return
      toggle?.setAttribute('aria-expanded', 'false')
    })

    // The set opens on focus as well as on a click, so the control reports the
    // state the reader is in rather than only the one a click put them in.
    // Focus anywhere inside opens it, the toggle included, because
    // `:focus-within` is what the stylesheet keys the stack to.
    dock.addEventListener('focusin', () => {
      toggle?.setAttribute('aria-expanded', 'true')
    })

    dock.addEventListener('focusout', (event) => {
      const next = (event as FocusEvent).relatedTarget
      if (next instanceof Node && dock.contains(next)) return
      if (dock.dataset.open === 'true') return
      toggle?.setAttribute('aria-expanded', 'false')
    })
  }
</script>
