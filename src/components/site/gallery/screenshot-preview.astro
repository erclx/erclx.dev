---
import type { ImageMetadata } from 'astro'
import PeekTrack from './peek-track.astro'

interface GalleryImage {
  readonly src: ImageMetadata
  readonly alt: string
}

interface Props {
  readonly images: readonly GalleryImage[]
}

const { images } = Astro.props
---

{/* A bigger mount of the same peek carousel rather than one fixed image with
    a pair of round arrow buttons. The peek itself is the prev/next
    affordance here, carrying the inline gallery's own language into the
    view a reader opened to look closer, so explicit arrows would repeat
    what the sliver already says. The position count stays, since it costs
    nothing and answers a question a peek alone does not: how many more.

    The width is fixed rather than fitted. A panel sized to its content takes
    its width from whichever slide is centred, and the five captures differ
    in height, so stepping resized the whole dialog under the reader:
    measured 958px wide on the first slide against 720px on the last. A fixed
    stage also keeps the track's own `cqw` basis still, so the slides do not
    resize as a reader steps between them. */}
<dialog
  data-gallery-preview
  class="bg-card text-foreground fixed inset-0 m-auto max-h-[94dvh] w-[96vw] overflow-hidden rounded-lg p-0 backdrop:bg-black/70"
>
  <button
    type="button"
    data-gallery-preview-close
    aria-label="Close preview"
    class="figure-dialog-control fixed top-4 right-4 z-20 inline-flex size-11 items-center justify-center rounded-full"
  >
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M18 6 6 18"></path>
      <path d="m6 6 12 12"></path>
    </svg>
  </button>

  <p
    data-gallery-preview-position
    aria-live="polite"
    class="figure-dialog-count fixed top-4 left-4 z-20 rounded-full px-3 py-1 font-mono text-label tabular-nums"
  >
  </p>

  <div class="flex max-h-[94dvh] flex-col overflow-auto p-4 md:p-6">
    <PeekTrack images={images} />
    <p
      data-gallery-preview-caption
      class="text-muted-foreground font-mono text-label mt-4 shrink-0"
    >
    </p>
  </div>
</dialog>
