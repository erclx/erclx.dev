---
import { getImage } from 'astro:assets'

import canonStillDark from '@/assets/projects/canon-dark.png'
import canonStill from '@/assets/projects/canon-light.png'
import launchLoopLight from '@/assets/videos/canon-light.mp4?url'
import launchLoop from '@/assets/videos/canon.mp4?url'
import RouteFoot from '@/components/site/case-study/route-foot.astro'
import RouteBar from '@/components/site/nav/route-bar.astro'
import SectionNav from '@/components/site/section-nav/section-nav.astro'
import BaseLayout from '@/layouts/base.astro'
import { getLinkTargetAttributes } from '@/lib/links'

const artifactLinks = [
  { label: 'GitHub', href: 'https://github.com/erclx/canon' },
  { label: 'npm', href: 'https://www.npmjs.com/package/@erclx/canon' },
  { label: 'Live build', href: 'https://canon.erclx.dev' },
]

// A `poster` attribute takes a URL rather than an image, so it reaches for the
// source file unless something derives the optimized one.
const [loopPoster, loopPosterDark] = await Promise.all([
  getImage({ src: canonStill, format: 'webp' }),
  getImage({ src: canonStillDark, format: 'webp' }),
])

const loopLabel =
  'One change running through canon, from the groundwork that measured it through its plan, dispatch, build, and review to the merge'

// The route's opening leads the rail, per the note in `jobtriage.astro`.
const navItems = [
  { id: 'canon', label: 'canon' },
  { id: 'why-i-built-it', label: 'why i built it' },
  { id: 'how-i-use-it', label: 'how i use it' },
  { id: 'what-it-shows', label: 'what it shows' },
]
---

<BaseLayout
  title="canon · Eric Le"
  description="canon runs a coding agent's work from plan to reviewed pull request, through one orchestrator that dispatches a planner, a worker and a reviewer."
  surface="case-study"
>
  <SectionNav items={navItems} instant />

  <RouteBar here="canon" />

  <main>
    <section id="canon" class="page-inset pt-16 pb-12 md:pt-20 md:pb-16">
      <div class="prose-column mx-auto">
        <p
          data-fade
          class="text-muted-foreground text-label tracking-wide uppercase"
        >
          Project
        </p>
        <h1
          data-fade
          class="font-display text-foreground mt-4 text-[2.25rem] leading-tight font-semibold md:text-[2.75rem]"
        >
          canon
        </h1>
        <p data-fade class="text-muted-foreground text-lede mt-4">
          canon is how I build with AI coding agents, packaged so any repository
          can install it. One session plans, another builds, and a separate one
          reviews the pull request.
        </p>
        <ul data-fade class="mt-6 flex flex-wrap gap-x-6">
          {
            artifactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...getLinkTargetAttributes(link.href)}
                  class="text-foreground text-label inline-flex min-h-11 min-w-11 items-center underline-offset-4 hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        {
          /* The loop closes the opening rather than interrupting it. It was
            recorded once per theme, and `hover-video` plays only the one the
            theme shows. It declares `view` so a phone, which cannot hover,
            plays it on screen. */
        }
        <figure
          data-media-host="view"
          data-fade
          class="figure-breakout bg-card border-border/60 mt-12 overflow-hidden rounded-lg border"
        >
          <video
            src={launchLoopLight}
            poster={loopPoster.src}
            muted
            loop
            playsinline
            preload="none"
            data-media-video
            aria-label={loopLabel}
            class="block h-auto w-full dark:hidden"></video>
          <video
            src={launchLoop}
            poster={loopPosterDark.src}
            muted
            loop
            playsinline
            preload="none"
            data-media-video
            aria-label={loopLabel}
            class="hidden h-auto w-full dark:block"></video>
        </figure>
      </div>
    </section>

    <section id="why-i-built-it" class="page-inset py-16 md:py-20">
      <div class="prose-column mx-auto">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          why i built it
        </h2>
        <p data-fade class="text-foreground text-lede mt-6">
          Every project I started got the same agent setup typed into it again,
          and every copy drifted from the last. I wanted one source I could
          install everywhere instead of a folder I kept rewriting.
        </p>
      </div>
    </section>

    <section id="how-i-use-it" class="page-inset py-16 md:py-20">
      <div class="prose-column mx-auto">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          how i use it
        </h2>
        <p data-fade class="text-foreground text-lede mt-6">
          I talk to one agent, an orchestrator, and it dispatches the rest. A
          planner writes the plan, a worker builds it on its own branch and
          opens a pull request with screenshots or a short clip of the change,
          and a reviewer that did not write the code reads it. I only talk to
          the others when they need my input, and I merge every pull request
          myself.
        </p>
      </div>
    </section>

    <section id="what-it-shows" class="page-inset py-16 md:py-20">
      <div class="prose-column mx-auto">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          what it shows
        </h2>
        <p data-fade class="text-foreground text-lede mt-6">
          I use it every day across all my repositories, including the private
          one that keeps my CV, LinkedIn and this site in step. canon.erclx.dev
          replays one real session it ran on itself. Open source on npm under
          the MIT license.
        </p>
      </div>
    </section>
  </main>

  <RouteFoot />

  <script>
    import { initWayHome } from '@/components/site/case-study/way-home'
    import { initHoverVideo } from '@/lib/hover-video'
    import { initReveal } from '@/lib/reveal'

    initReveal()
    initWayHome()
    initHoverVideo()
  </script>
</BaseLayout>
