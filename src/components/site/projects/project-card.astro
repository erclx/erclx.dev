---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

import { getLinkTargetAttributes } from '@/lib/links'

interface ProjectLink {
  label: string
  href: string
}

interface Props {
  name: string
  description: string
  poster?: ImageMetadata
  videoSrc?: string
  mediaAlt?: string
  mediaPosition?: string
  links: ProjectLink[]
  caseStudyHref?: string
  index?: number
  isWide?: boolean
}

const {
  name,
  description,
  poster,
  videoSrc,
  mediaAlt,
  mediaPosition = 'top',
  links,
  caseStudyHref,
  index = 0,
  isWide = false,
} = Astro.props

const fadeDelay = `${index * 200}ms`
// The origin section links a chip to each card by name, so every card needs a
// stable target of its own.
const cardId = name.toLowerCase()
---

{/* No plate, no outline, and no rule under the media. The card drew three
    boxes on a page whose hero ground dissolves, whose bar lost its rule, and
    which runs one field under every section, so it was the surface still
    arguing with the rest.

    What remains framed is the still, which is the content. The prose sits on
    the page ground, so the field runs behind the whole section rather than
    stopping at five rectangles.

    The tilt moved off this element and onto the media below. Rotating a card
    with no visible bounds tilts nothing a reader can see, and the pointer
    target stays the whole card, so the region that answers is unchanged and
    only the thing with mass moves. */}
<article
  id={cardId}
  data-fade
  data-tilt
  data-media-host
  style={`--fade-delay: ${fadeDelay}`}
  class:list={[
    'scroll-mt-24 group/card relative isolate flex h-full flex-col',
    isWide && 'lg:flex-row lg:items-stretch',
  ]}
>
  {
    poster && mediaAlt && (
      <div
        data-media-slot
        class:list={[
          'bg-muted/40 relative aspect-[11/7] overflow-hidden rounded-lg p-2 sm:p-3 [transform:perspective(900px)_rotateX(var(--tilt-x,0deg))_rotateY(var(--tilt-y,0deg))] [transform-style:preserve-3d] [will-change:transform]',
          isWide && 'lg:aspect-auto lg:w-1/2 lg:min-h-72',
        ]}
      >
        <div class="ring-border/40 relative size-full overflow-hidden rounded-md shadow-sm ring-1 [transform:translate3d(var(--parallax-x,0),var(--parallax-y,0),0)] [will-change:transform]">
          <Image
            src={poster}
            alt={mediaAlt}
            style={`object-position: ${mediaPosition}`}
            class="absolute inset-0 size-full object-cover"
            data-media-poster
          />
          {videoSrc && (
            <video
              src={videoSrc}
              poster={poster.src}
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
              style={`object-position: ${mediaPosition}`}
              class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-200 group-hover/card:opacity-100"
              data-media-video
            />
          )}
        </div>
      </div>
    )
  }
  {/* The horizontal inset goes with the plate that justified it. Prose sitting
      on the page ground indents from nothing, so it would have started right
      of every other reading edge in the section. */}
  <div class:list={['pt-6 md:pt-8', isWide && 'lg:flex-1 lg:self-center lg:pt-0 lg:pl-10']}>
    <h3 class="font-display text-heading text-foreground">
      {name}
    </h3>
    <p class="text-muted-foreground text-body mt-4">
      {description}
    </p>
    <ul class="mt-6 flex flex-wrap gap-x-6">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              {...getLinkTargetAttributes(link.href)}
              class="text-foreground text-label relative z-10 inline-flex min-h-11 min-w-11 items-center underline-offset-4 hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  {
    caseStudyHref && (
      <a
        href={caseStudyHref}
        aria-hidden="true"
        tabindex="-1"
        class="absolute inset-0"
      />
    )
  }
</article>

<style>
  /* Unboxing the card removed the only thing stating where it ended, so a
     pointer had nothing to land on and no way to read how far the card
     reached. This gives that back under the pointer alone: the shape is
     revealed rather than drawn, so the section stays borderless at rest.

     A pseudo-element inset outward rather than padding on the card, so the
     revealed shape is larger than the content and costs no layout. The card
     isolates, which keeps this behind its own content rather than behind the
     section. */
  [data-media-host]::after {
    content: '';
    position: absolute;
    inset: -1.5rem;
    border-radius: 1rem;
    z-index: -1;
    opacity: 0;
    background: color-mix(in oklab, var(--card) 60%, transparent);
    /* No spread, and a radius that stays inside the gutter. The halo reaches
       24px for its own box and 20px more for the shadow, against a 48px
       gutter, so two neighbors never light together. */
    box-shadow: 0 0 1.25rem 0
      color-mix(in oklab, var(--foreground) 7%, transparent);
  }
  [data-media-host]:hover::after,
  [data-media-host]:focus-within::after {
    opacity: 1;
  }

  /* Asymmetric on purpose. Arriving is immediate, because a control answering
     late reads as broken, and leaving takes four times as long, so crossing
     the grid trails a glow behind the pointer rather than snapping off at
     every gutter. The two rules are what make one transition do both. */
  @media (prefers-reduced-motion: no-preference) {
    [data-media-host]::after {
      transition: opacity 520ms ease-out;
    }
    [data-media-host]:hover::after,
    [data-media-host]:focus-within::after {
      transition: opacity 130ms ease-out;
    }
  }
</style>
