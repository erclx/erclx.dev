---
import '@/styles/global.css'
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url'
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'

import PageGround from '@/components/site/page-ground/page-ground.astro'
import SiteBar from '@/components/site/nav/site-bar.astro'
import ContactDock from '@/components/site/contact-dock/contact-dock.astro'

interface Props {
  title: string
  description: string
  // A route naming its surface lets the stylesheet scope tokens to it. The
  // landing page names none, so its measure and type stay where they are.
  surface?: 'case-study'
}

const { title, description, surface } = Astro.props
const isRoute = surface === 'case-study'

// The card is one image for every page, so its alt text describes the card
// rather than the page it is attached to.
const ogImageAlt =
  'The claim this site opens on, set over the contour field it runs behind every page'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* The vector leads. It held the tab until 2026-08-15, when the mark was
        268 stippled dots that averaged to grey at 16px, and the rasters took
        over on that measurement. The mark is three shapes now and the same
        instrument reverses the finding: it peaks at luminance 239 with 48 of
        256 pixels above 180, where the raster it replaces peaked at 221 with
        30. The raster stays as the fallback for an engine that ignores an SVG
        icon, and it is reached only by those engines, since one that reads the
        vector never requests it. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href={frauncesUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={interUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    {/* Every host reads these same tags and differs only in what it renders
        from them, so there is one image and one set of copy rather than a
        variant per network. The card carries no name, because each of them
        prints the title beside it and a name in both is the same word twice in
        one unfurl.

        Absolute rather than root-relative. A crawler fetches the image on its
        own rather than in the page's context, so a leading slash resolves
        against nothing. `site` in the Astro config is what makes this work. */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="erclx.dev" />

    {/* X shows a thumbnail beside the text without this and the full card with
        it, so the tag is what decides the size rather than the image. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <script is:inline>
      const stored = localStorage.getItem('theme')
      const mode =
        stored === 'light' || stored === 'dark' || stored === 'system'
          ? stored
          : 'system'
      const prefersDark = window.matchMedia(
        '(prefers-color-scheme: dark)',
      ).matches
      if (mode === 'dark' || (mode === 'system' && prefersDark)) {
        document.documentElement.classList.add('dark')
      }
      document.documentElement.dataset.themeMode = mode
      document.documentElement.dataset.js = 'true'
    </script>
  </head>
  <body
    class:list={[
      'bg-background text-foreground font-sans antialiased',
      surface && `surface-${surface}`,
    ]}
  >
    {/* A route already renders a top bar of its own, which the stylesheet
        makes sticky. Only the landing page needs one mounted, so the two never
        stack. */}
    <PageGround />
    {!isRoute && <SiteBar />}
    {/* Every surface carries it, where the landing page rendered it alone
        until 2026-08-20. A route is the longest read on the site and the one
        a shared link lands on, which is the arrival that skips the landing
        page and every contact link on it.

        A route reveals it at once. Its gate watches the header for the hero
        to scroll past, and a route's header is the sticky bar, which never
        leaves the viewport: measured across a full scroll of a route, the
        intersection ratio reads 1 and only 1, so the control would never
        arrive at all. The rail already answers the same problem the same way
        on the same surfaces. */}
    <ContactDock instant={isRoute} />
    <slot />
  </body>
</html>
