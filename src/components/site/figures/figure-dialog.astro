---

{/* The panel takes most of the screen rather than a fixed thousand pixels.
    A figure that opened into 1000px was narrower than the plate the page
    already gave it above roughly 1488px of viewport, so a reader who clicked
    to see more saw less.

    No slice of the neighboring figures shows at the edges. Width is the
    scarce resource every sizing decision here has been spent buying, and a
    neighbor costs the figure being read to advertise what the counter
    already states.

    Positioned explicitly rather than relatively. A modal dialog is fixed by
    the user agent, and `relative` overrode that and dropped the panel into
    normal flow near the top of the document, so it rendered at minus the
    scroll position and a reader deep in a route opened onto nothing. It was
    invisible for as long as locking the page also reset the scroll to zero,
    which put an in-flow panel at the top of the viewport by accident. */}
<dialog
  data-figure-dialog
  class="bg-card text-foreground fixed inset-0 m-auto max-h-[94dvh] max-w-[96vw] overflow-hidden rounded-lg p-0 backdrop:bg-black/70"
>
  {/* Every control is pinned to the viewport rather than to the panel. The
      panel is sized to its picture, so stepping from a portrait to a landscape
      resizes it, and chrome anchored to it moves out from under a pointer that
      has not moved: a reader stepping quickly hit close where next had been.
      Fixed inside a dialog resolves against the viewport, since the top layer
      is the containing block, so these hold one position for every figure. */}
  <button
    type="button"
    data-figure-close
    aria-label="Close figure"
    class="figure-dialog-control fixed top-4 right-4 z-20 inline-flex size-11 items-center justify-center rounded-full"
  >
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M18 6 6 18"></path>
      <path d="m6 6 12 12"></path>
    </svg>
  </button>

  {/* Each step sits on the side it moves toward, so the control's position is
      its meaning and neither glyph has to be read. Grouping the two put them
      118px apart in one corner, where a reader worked out which was which,
      and put next beside close. */}
  <button
    type="button"
    data-figure-prev
    aria-label="Previous figure"
    class="figure-dialog-control fixed top-1/2 left-4 z-20 inline-flex size-11 -translate-y-1/2 items-center justify-center rounded-full disabled:opacity-30"
  >
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m15 18-6-6 6-6"></path>
    </svg>
  </button>

  <button
    type="button"
    data-figure-next
    aria-label="Next figure"
    class="figure-dialog-control fixed top-1/2 right-4 z-20 inline-flex size-11 -translate-y-1/2 items-center justify-center rounded-full disabled:opacity-30"
  >
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m9 18 6-6-6-6"></path>
    </svg>
  </button>

  {/* The position stays in the corner opposite close, which is where a gallery
      states it and where it never competes with the steps. */}
  <p
    data-figure-position
    aria-live="polite"
    class="figure-dialog-count fixed top-4 left-4 z-20 rounded-full px-3 py-1 font-mono text-label tabular-nums"
  >
  </p>

  <div
    data-figure-scroll
    class="flex max-h-[94dvh] flex-col overflow-auto p-4 md:p-6"
  >
    <img
      data-figure-dialog-image
      src=""
      alt=""
      class="figure-dialog-image mx-auto block rounded-md"
    />
    <p
      data-figure-dialog-caption
      class="text-muted-foreground font-mono text-label mt-4 shrink-0"
    >
    </p>
  </div>
</dialog>

<style is:global>
  /* The controls sit over the backdrop on a narrow figure and over the picture
     on a wide one, so they carry the page's own floating ground rather than
     relying on what happens to be behind them. */
  .figure-dialog-control,
  .figure-dialog-count {
    background: var(--floating-fill);
    backdrop-filter: var(--floating-blur);
    border: 1px solid var(--border);
    box-shadow: var(--floating-shadow);
    color: var(--muted-foreground);
  }
  .figure-dialog-control:hover:not(:disabled),
  .figure-dialog-control:focus-visible {
    color: var(--foreground);
    box-shadow: var(--floating-shadow), var(--glow-shadow);
  }
  @media (prefers-reduced-motion: no-preference) {
    .figure-dialog-control {
      transition:
        color 150ms ease-out,
        box-shadow var(--glow-out) ease-out;
    }
    .figure-dialog-control:hover:not(:disabled),
    .figure-dialog-control:focus-visible {
      transition:
        color 150ms ease-out,
        box-shadow var(--glow-in) ease-out;
    }
  }

  /* Fitted, which is how every figure opens, including one arrived at by
     stepping. The picture takes whatever height the panel has left after its
     padding and its caption, rather than a ceiling written as a length.

     A written ceiling was 4px short on every portrait at every viewport,
     because the chrome under the picture costs 84px against the 80 it
     allowed, and the panel scrolled in the one state whose whole purpose is
     that it does not. Any figure taken from that arithmetic breaks again the
     moment a caption wraps to a second line, so the box is asked instead. */
  .figure-dialog-image {
    flex: 1 1 auto;
    min-height: 0;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    cursor: zoom-in;
  }

  /* Magnified to the figure's own pixels, and out of the flex sizing above so
     it keeps them. The scroll container around it becomes the pan, which is
     the state the fitted default exists to keep out of the way until a reader
     asks for it. */
  [data-magnified] .figure-dialog-image {
    flex: none;
    min-height: auto;
    max-height: none;
    max-width: none;
    width: var(--figure-natural-width);
    cursor: zoom-out;
  }

  /* A route carrying one figure has nothing to step to, so it states nothing
     rather than showing two dead controls and `1 / 1`. */
  [data-figure-dialog][data-single]
    :is([data-figure-prev], [data-figure-next], [data-figure-position]) {
    display: none;
  }
</style>
