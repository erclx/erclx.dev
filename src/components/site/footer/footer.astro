---
import signatureSvg from '@/assets/footer/signature.svg?raw'

// Taken at build time, so it states the last deploy rather than the current
// date and stays true without anything maintaining it. A month rather than a
// year alone, because within the current year a bare year carries almost no
// information, which is the ambiguity this line replaced.
const updated = new Date().toLocaleDateString('en-GB', {
  month: 'long',
  year: 'numeric',
})
---

<footer data-section="footer" class="px-6 pb-10 md:pb-16">
  <div
    class="border-border mx-auto max-w-3xl border-t pt-10 md:pt-12 lg:max-w-5xl"
  >
    <div
      data-signature
      aria-hidden="true"
      class="text-foreground aspect-[716/255] w-[clamp(7rem,_14vw_+_3rem,_16rem)] max-w-full [&>svg]:block [&>svg]:size-full"
      set:html={signatureSvg}
    >
    </div>
    <div
      class="mt-8 flex flex-col gap-3 md:mt-10 md:flex-row md:items-end md:justify-between md:gap-12"
    >
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener"
        class="text-foreground text-label inline-flex min-h-11 items-center gap-2 underline-offset-4 hover:underline"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="text-muted-foreground size-4 -rotate-12"
        >
          <path
            d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 17.99 8.7l-8.57 8.57a2 2 0 0 1-2.83-2.83l8.49-8.49"
          ></path>
        </svg>
        Résumé
      </a>
      {/* The city left this line rather than moving. The closing ask already
          states it as a filter, which is where the scope doc put it, so the
          footer was repeating it beside a year that read as a copyright with
          its symbol missing. */}
      <div class="text-muted-foreground text-label md:text-right">
        {/* The page claims its author builds the layer between a language
            model and the job it has to do. Stating how the page itself was
            made is that claim demonstrated on the one artifact the reader is
            already inside, rather than asserted again. */}
        <p>Designed and built with coding agents, which is also the work.</p>
        <p class="mt-1">Updated {updated}</p>
      </div>
    </div>
  </div>
</footer>

<script>
  import { initFooterSignature } from './footer-signature'

  initFooterSignature()
</script>
