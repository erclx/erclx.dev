              d="M 60 80 Q 56 84 51 82"
              stroke="#2a1d14"
              stroke-width="1.5"
              stroke-linecap="round"
              fill="none"></path>
            <path
              d="M 60 80 Q 64 84 69 82"
              stroke="#2a1d14"
