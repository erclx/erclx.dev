---
import BarMark from '@/components/site/nav/bar-mark.astro'
import SectionNav from '@/components/site/section-nav/section-nav.astro'
import ThemeToggle from '@/components/site/theme-toggle/theme-toggle.astro'

interface Props {
  // The route names itself, so a reader arriving from a shared link knows
  // where they are rather than only how to leave.
  here: string
  // The route's sections after its opening, since the name above already
  // returns a reader to the top.
  items: readonly { readonly id: string; readonly label: string }[]
}

const { here, items } = Astro.props
---

{
  /* The stylesheet makes this bar sticky, so it is the way home for the whole
    scroll rather than the first 77px. Its row runs to the page inset as the
    landing page's bar does, so the chrome holds its shape across a navigation
    even though the prose under it is a different width. */
}
<header data-section="header" class="page-inset relative">
  {
    /* The same ground the landing bar renders, so a reader crossing between the
      two meets one bar. It takes its hairline here on the reader's own scroll,
      which is the state a route can actually show: this bar sits at the top of
      the page from load, where the landing bar only arrives once the hero has
      gone. */
  }
  <div data-bar-ground aria-hidden="true"></div>
  {
    /* The row arrives with the prose rather than ahead of it. The mark, the
      name and the toggle were the only things on a route already painted while
      everything under them faded up, which read as the chrome belonging to a
      different page than its content. The landing bar is deliberately not
      marked: its name and toggle fly in from the hero on measured positions,
      and an opacity transition there reopens the three placement defects
      `canon/context/chrome/site-bar.md` records. Same arrival, different mechanism. */
  }
  {
    /* The landing bar's arrangement, so one pattern frames every surface: the
      lockup left, the section links and the toggle right. The lockup here is a
      breadcrumb, `Eric Le / <route>`, so the route names itself in the same
      place the landing page puts the name alone. */
  }
  <div data-fade data-bar-row class="relative flex items-center py-4">
    <div class="text-label flex min-w-0 items-center">
      {
        /* One control carrying both, the way the landing bar carries them, so
          the chrome holds one shape and one hit area as a reader crosses
          between the two surfaces. The mark stays decoration inside the link
          rather than becoming a second link to the same place. */
      }
      <a
        href="/"
        data-way-home
        class="text-foreground flex min-h-11 shrink-0 items-center gap-2.5 underline-offset-4 hover:underline"
      >
        <BarMark />
        Eric Le
      </a>
      <span aria-hidden="true" class="text-muted-foreground px-2.5">/</span>
      {
        /* The route's crumb is the way back to its own top, since the lockup
          beside it and the closing foot both leave for the landing page. It
          shows from the first frame, since a breadcrumb missing its last crumb
          reads as `Eric Le /`, and it is the part that gives way when a long
          name meets the menu and the toggle on a phone. */
      }
      <button
        type="button"
        data-route-here
        aria-label={`Back to top of ${here}`}
        class="text-foreground inline-flex min-h-11 min-w-0 cursor-pointer items-center underline-offset-4 hover:underline"
      >
        <span class="truncate">{here}</span>
      </button>
    </div>
    {
      /* A route with one section has nothing to jump between, and an empty
        nav still drew the phone's Sections toggle opening onto nothing. The
        spacer keeps the toggle on the right edge in its place. */
      items.length > 0 ? (
        <SectionNav items={items} />
      ) : (
        <span aria-hidden="true" class="ml-auto" />
      )
    }
    <ThemeToggle />
  </div>
</header>

<style>
  /* Read by the sections sheet to hang from the bar's bottom edge. */
  header {
    --bar-height: var(--sticky-bar-height);
  }
</style>

<script>
  // The bar carries no edge at the top of the route and takes its hairline
  // once the reader is into the prose. A route shows both states, where the
  // landing page only ever arrives already scrolled.
  const CONDENSE_AFTER_PX = 240

  const routeBar = document.querySelector<HTMLElement>(
    'header[data-section="header"]',
  )
  if (routeBar) {
    let pending = false
    const readScroll = () => {
      pending = false
      if (window.scrollY > CONDENSE_AFTER_PX) {
        routeBar.setAttribute('data-condensed', 'true')
      } else {
        routeBar.removeAttribute('data-condensed')
      }
    }
    // Coalesced to a frame, since scroll fires per pixel of a drag.
    window.addEventListener(
      'scroll',
      () => {
        if (pending) return
        pending = true
        requestAnimationFrame(readScroll)
      },
      { passive: true },
    )
    readScroll()
  }

  const here = document.querySelector<HTMLElement>('[data-route-here]')

  here?.addEventListener('click', () => {
    // The root's own `scroll-behavior` decides, so the motion preference is
    // read in the one place the whole site reads it rather than here as well.
    window.scrollTo({ top: 0 })

    // A section link leaves a fragment naming a section the reader has left,
    // and this control scrolls rather than navigates, so nothing else clears
    // it. Replaced rather than pushed, so leaving the top costs one back press.
    if (window.location.hash) {
      window.history.replaceState(
        null,
        '',
        window.location.pathname + window.location.search,
      )
    }
  })
</script>
