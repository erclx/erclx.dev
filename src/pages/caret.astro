---
import { getImage } from 'astro:assets'

import BaseLayout from '@/layouts/base.astro'
import RouteBar from '@/components/site/nav/route-bar.astro'
import SectionNav from '@/components/site/section-nav/section-nav.astro'
import RouteFoot from '@/components/site/case-study/route-foot.astro'
import { getLinkTargetAttributes } from '@/lib/links'
import caretPoster from '@/assets/projects/caret.png'
import caretDemo from '@/assets/videos/caret.mp4?url'

const artifactLinks = [
  {
    label: 'Chrome Web Store',
    href: 'https://chromewebstore.google.com/detail/caret/bpmdbibldelkpncegllkeegdpblgehgk',
  },
  { label: 'GitHub', href: 'https://github.com/erclx/caret' },
]

// A `poster` attribute takes a URL rather than an image, so it reaches for the
// source file unless something derives the optimized one.
const demoPoster = await getImage({ src: caretPoster, format: 'webp' })

const navItems = [
  { id: 'problem', label: 'problem' },
  { id: 'trigger', label: 'trigger' },
  { id: 'adapters', label: 'adapters' },
]
---

<BaseLayout
  title="Caret · Eric Le"
  description="A prompt palette that opens where the cursor already is, on three chat sites that each handle text differently."
  surface="case-study"
>
  <SectionNav items={navItems} instant />

  <RouteBar here="Caret" />

  <main>
    <section class="page-inset pt-16 pb-12 md:pt-20 md:pb-16">
      <div class="mx-auto prose-column">
        <p
          data-fade
          class="text-muted-foreground text-label tracking-wide uppercase"
        >
          Project
        </p>
        <h1
          data-fade          class="font-display text-foreground mt-4 text-[2.25rem] leading-tight font-semibold md:text-[2.75rem]"
        >
          Caret
        </h1>
        <p
          data-fade          class="text-muted-foreground text-lede mt-4"
        >
          A prompt palette that opens where the cursor already is, on three chat
          sites that each handle text differently.
        </p>
        <ul
          data-fade          class="mt-6 flex flex-wrap gap-x-6"
        >
          {
            artifactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...getLinkTargetAttributes(link.href)}
                  class="text-foreground text-label inline-flex min-h-11 min-w-11 items-center underline-offset-4 hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        {/* The demo closes the opening rather than interrupting it. It declares
            `view` so a phone, which cannot hover, plays it on screen. */}
        <figure
          data-media-host="view"
          data-fade          class="figure-breakout bg-card border-border/60 mt-12 overflow-hidden rounded-lg border"
        >
          <video
            src={caretDemo}
            poster={demoPoster.src}
            muted
            loop
            playsinline
            preload="none"
            data-media-video
            aria-label="A trigger symbol typed in a chat input opening a prompt palette above the cursor, and the chosen prompt landing in the input"
            class="block h-auto w-full"></video>
        </figure>
      </div>
    </section>

    <section id="problem" class="page-inset py-16 md:py-20">
      <div class="mx-auto prose-column">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          problem
        </h2>
        <p
          data-fade          class="text-foreground text-lede mt-6"
        >
          I was retyping the same instructions into Claude, Gemini, and ChatGPT
          several times a day. Each one holds text differently, so there was
          nowhere to keep a prompt that all three could reach.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          The prompts worth reusing end up in a notes file, which means leaving
          the chat, finding the one you want, and pasting it back.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          The gap is small and you cross it many times a day.
        </p>
      </div>
    </section>

    <section id="trigger" class="page-inset py-16 md:py-20">
      <div class="mx-auto prose-column">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          trigger
        </h2>
        <p
          data-fade          class="text-foreground text-lede mt-6"
        >
          Typing the trigger symbol at a word boundary opens a palette anchored
          above the cursor. Fuzzy search filters the library and the keyboard
          inserts the prompt without leaving the input.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          The symbol is configurable per site, because one that is free on a
          chat surface collides with a native shortcut on another.
        </p>
      </div>
    </section>

    <section id="adapters" class="page-inset py-16 md:py-20">
      <div class="mx-auto prose-column">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          adapters
        </h2>
        <p
          data-fade          class="text-foreground text-lede mt-6"
        >
          Three sites, two editor models. Claude and ChatGPT render their inputs
          through ProseMirror, Gemini uses a plain <code class="font-mono"
            >contenteditable</code
          >.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          Writing into either directly corrupts the host's own state, so each
          site gets an adapter that synthesizes the events a real keystroke
          would produce rather than setting the value.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          The <code class="font-mono">contenteditable</code> adapter walks the DOM
          to find an absolute cursor position across fragmented text nodes, which
          is what makes the palette land in the right place rather than near it. Nothing
          leaves the browser.
        </p>
      </div>
    </section>
  </main>

  <RouteFoot />

  <script>
    import { initWayHome } from '@/components/site/case-study/way-home'
    import { initHoverVideo } from '@/lib/hover-video'
    import { initReveal } from '@/lib/reveal'

    initReveal()
    initWayHome()
    initHoverVideo()
  </script>
</BaseLayout>
