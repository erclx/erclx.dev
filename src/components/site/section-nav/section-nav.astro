---
interface SectionNavItem {
  readonly id: string
  readonly label: string
}

interface Props {
  items?: readonly SectionNavItem[]
  instant?: boolean
}

const {
  // A label reads as the heading it points at rather than as its anchor id,
  // which is what had put a hyphenated slug in front of a reader. The case
  // studies pass their own, lowercase, because their headings are.
  items = [
    { id: 'about', label: 'About me' },
    { id: 'experience', label: 'Experience' },
    { id: 'projects', label: 'Projects' },
    { id: 'looking-for', label: 'Looking for' },
  ],
  instant = false,
} = Astro.props
---

{/* `instant` names the absence of a scroll gate and nothing else. It also
    painted the rail at server render until 2026-08-24, which put the one piece
    of chrome on a route on screen before the prose beside it had begun to
    arrive. The script reveals it on load instead, so it fades with the page. */}
<nav
  data-section-nav
  data-instant={instant ? 'true' : undefined}
  aria-label="Sections"
  class="section-nav fixed top-1/2 left-6 z-20 hidden -translate-y-1/2 flex-col gap-0.5 xl:flex"
>
  {
    items.map((item) => (
      <a
        href={`#${item.id}`}
        data-target={item.id}
        class="section-nav-link text-muted-foreground text-label"
      >
        {item.label}
      </a>
    ))
  }
</nav>

<style>
  /* Hidden until revealed only where a script can do the revealing. Gated on
     `[data-js='true']`, the same escape `[data-fade]` uses in global.css, so a
     route with no script running keeps the rail at its native opacity rather
     than parking it invisible forever: nothing after this ever sets
     `data-revealed` without JS, and the rail was the one piece of chrome on a
     route's longest reads that a no-JS visitor could lose entirely. */
  :global([data-js='true']) .section-nav {
    opacity: 0;
    pointer-events: none;
  }
  .section-nav[data-revealed='true'] {
    opacity: 1;
    pointer-events: auto;
  }
  /* Every link holds the pill's box whether or not it is filled, so the rail
     never changes height as the active item moves down the page. Only one of
     them is ever painted. */
  .section-nav-link {
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    /* Pulled left by its own padding, so a label at rest sits where it sat
       when this was a bare 2px edge. The active one gives that back below. */
    margin-left: -0.85rem;
    /* The step's own duration is held off until the rail has placed its first
       row. A route marks a row active on the first frame, so a duration
       standing here sent that row sliding out of the column on load, which
       reads as the rail correcting itself. The easing exists for a handover
       between two rows and there is no handover on arrival. */
    transition:
      color 150ms ease-out,
      border-color 150ms ease-out,
      background-color 150ms ease-out,
      box-shadow 200ms ease-out,
      transform var(--rail-step, 0ms) cubic-bezier(0.34, 1.3, 0.64, 1);
  }
  /* A row a reader is pointing at, which is a different claim from the row
     they are inside. The glow answers the pointer and the ground below
     answers the scroll position, so the two never say the same thing.

     The edge is part of that answer here, which it was not until now. Measured
     across the site, this was the one bounded control whose hover left its
     border alone: a chip and a dock control both take the accent, and a rail
     row moved fill and shadow while its edge held at 1.08:1 against the page
     in light and 1.03:1 in dark, which is no edge at all. What separates a
     pointed-at row from the row a reader is inside is now the ground, the
     blur, and the step, rather than the edge on its own. */
  .section-nav-link:hover,
  .section-nav-link:focus-visible {
    color: var(--foreground);
    border-color: var(--accent);
    background: var(--glow-fill);
    box-shadow: var(--glow-shadow);
  }
  /* The ground the contact dock carries, on the one item that means something
     by carrying it. The dock uses it as a hit target for icons that have no
     other bounds; here it states which section the reader is in, so the two
     margins read as one system and the left one still does the job the right
     one does not. It replaces a 2px accent edge, which stated the same thing
     in the same color with less of it. */
  .section-nav-link[data-active='true'] {
    color: var(--foreground);
    background: var(--floating-fill);
    backdrop-filter: var(--floating-blur);
    border-color: var(--accent);
    box-shadow: var(--floating-shadow);
    /* The one item that steps out of the column. Reading down the page moves
       this from row to row, and each label leans right and settles back as it
       is handed on, so the rail states position by moving rather than only by
       lighting up.

       A transform rather than the margin it visually undoes, because the
       margin is layout and would shove every label below it on each handover.
       This moves paint alone, so the four boxes never change. */
    transform: translateX(0.85rem);
  }

  /* The active row still answers a pointer. It already carries a ground, so
     the glow stacks on top of it rather than replacing it, which is what the
     dock does for the same reason: swapping one shadow for the other makes a
     lit control appear to drop as it lights. */
  .section-nav-link[data-active='true']:hover,
  .section-nav-link[data-active='true']:focus-visible {
    box-shadow: var(--floating-shadow), var(--glow-shadow);
  }

  @media (prefers-reduced-motion: no-preference) {
    .section-nav {
      transition: opacity 300ms ease-out;
    }
    .section-nav[data-settled='true'] {
      --rail-step: 260ms;
    }
  }
  /* The step is the whole gesture, so under this preference it is dropped
     rather than shortened, and the ground alone carries the active row. */
  @media (prefers-reduced-motion: reduce) {
    .section-nav-link {
      transition: none;
    }
    .section-nav-link[data-active='true'] {
      transform: none;
    }
  }
</style>

<script>
  import { ANCHOR_RATIO } from '@/lib/section-nav'

  const nav = document.querySelector<HTMLElement>('[data-section-nav]')
  if (nav && 'IntersectionObserver' in window) {
    const links = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>('.section-nav-link'),
    )
    const sections = links
      .map((link) => {
        const id = link.dataset.target
        return id ? document.getElementById(id) : null
      })
      .filter((el): el is HTMLElement => el !== null)

    const setActive = (id: string | null) => {
      for (const link of links) {
        if (link.dataset.target === id) {
          link.setAttribute('data-active', 'true')
          link.setAttribute('aria-current', 'location')
        } else {
          link.removeAttribute('data-active')
          link.removeAttribute('aria-current')
        }
      }
    }

    const CLICK_LOCK_MS = 700
    let scrollFrame: number | null = null
    let clickLockUntil = 0

    const computeActive = () => {
      scrollFrame = null
      if (performance.now() < clickLockUntil) return
      const atBottom =
        window.scrollY + window.innerHeight >=
        document.documentElement.scrollHeight - 4
      if (atBottom && sections.length > 0) {
        setActive(sections[sections.length - 1].id)
        return
      }
      const anchor = window.innerHeight * ANCHOR_RATIO
      let activeId: string | null = null
      for (const section of sections) {
        const top = section.getBoundingClientRect().top
        if (top <= anchor) {
          activeId = section.id
        } else {
          break
        }
      }
      setActive(activeId)
    }

    const scheduleCompute = () => {
      if (scrollFrame === null) {
        scrollFrame = window.requestAnimationFrame(computeActive)
      }
    }

    window.addEventListener('scroll', scheduleCompute, { passive: true })
    window.addEventListener('resize', scheduleCompute)
    computeActive()

    // The first row is placed by the call above, and the step is given its
    // duration only after that has painted, so the row arrives already out of
    // the column rather than traveling there.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => nav.setAttribute('data-settled', 'true'))
    })

    const isInstant = nav.dataset.instant === 'true'
    // A route has no hero to scroll past, so the rail arrives with the page.
    // Deferred by a frame so the transition has a value to run from, since an
    // attribute set in the same frame as the first paint changes nothing a
    // reader sees.
    if (isInstant) {
      requestAnimationFrame(() =>
        nav.setAttribute('data-revealed', 'true'),
      )
    }
    if (!isInstant) {
      const hero = document.querySelector<HTMLElement>(
        '[data-section="header"]',
      )
      if (hero) {
        const heroObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                nav.removeAttribute('data-revealed')
              } else {
                nav.setAttribute('data-revealed', 'true')
              }
            }
          },
          // The rail arrives exactly where it gains something to say. A margin
          // of half the viewport revealed it 0.2 viewport heights before the
          // first section crossed the anchor, so it painted at full opacity
          // naming no row for 150px at 1280, 170px at 1440, and 210px at 1920,
          // a window that grows with the screen because both ends are
          // fractions of it.
          //
          // Derived from the anchor rather than written beside it, and the
          // arithmetic is why: the hero holds the viewport height wherever this
          // rail is visible, so a hero whose bottom edge sits at the anchor is
          // the same moment the section under it crosses that anchor. One
          // number therefore places both lines, and a second literal would
          // reopen the gap the moment either moved.
          {
            threshold: 0,
            rootMargin: `-${ANCHOR_RATIO * 100}% 0px 0px 0px`,
          },
        )
        heroObserver.observe(hero)
      }
    }

    for (const link of links) {
      link.addEventListener('click', (e) => {
        const id = link.dataset.target
        if (!id) return
        const target = document.getElementById(id)
        if (!target) return
        e.preventDefault()
        setActive(id)
        clickLockUntil = performance.now() + CLICK_LOCK_MS
        // No behavior named, so the root's own `scroll-behavior` decides.
        // Naming `smooth` here forced a glide on a reader who had asked for
        // none, which is the branch the bar was carrying by hand and this rail
        // was missing outright.
        target.scrollIntoView({ block: 'start' })
      })
    }
  }
</script>
