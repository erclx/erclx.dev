---
/**
 * The agent cast, scattered down both margins of the experience section.
 *
 * Desktop only. Measured at 390 and 768 the clear margin is 0px on both sides,
 * and the alternative was placing characters inside a reading column already
 * running 2067px at 390. The breakpoint matches the section rail's, which is
 * the other control that stands down for the same reason.
 *
 * Where every figure stands lives in `placement.ts`, so the guards can read it
 * without rendering the page. This file owns the markup, the palette and the
 * behavior wiring, and nothing about who is where.
 */
import {
  POWER_OVERHANG,
  renderMember,
  renderPet,
  renderPower,
} from './cast.ts'
import { TEMPERAMENTS } from './behaviors.ts'
import {
  clusterGap,
  clusters,
  clusterWidth,
  memberIndex,
} from './placement.ts'
import './motion.css'
---

<div
  class="cast-field"
  data-cast-field
  aria-hidden="true"
  style={`--power-overhang: ${POWER_OVERHANG}`}
>
  {
    clusters.map((cluster) => (
      <div
        class:list={['cast-cluster', `is-${cluster.side}`]}
        data-cast-cluster
        style={`--cluster-top: ${cluster.top}%; --cluster-gap: ${clusterGap(cluster)}px; --cluster-width: ${clusterWidth(cluster)}px`}
      >
        {cluster.members.map((member) => (
          <div
            class:list={['cast-member', member.seated && 'is-idle']}
            data-cast-member
            data-member={memberIndex(cluster, member)}
            data-idle={TEMPERAMENTS[member.mood].idle ?? undefined}
            data-react={TEMPERAMENTS[member.mood].react.join(' ')}
            data-react-tap={member.tapMood ? TEMPERAMENTS[member.tapMood].react.join(' ') : undefined}
            style={`--cast-dx: ${member.dx}px; --cast-dy: ${member.dy}px; --cast-size: ${member.size}px; --cast-delay: ${cluster.delay}ms; --cast-offset: ${-(cluster.phase + member.phase)}ms`}
          >
            {/* Behind the body in its own layer, so it can carry a clock the
                member does not. */}
            {member.power && (
              <span class="cast-power-layer" data-power={member.power}>
                <Fragment set:html={renderPower(member.power, member.facing)} />
              </span>
            )}
            {member.tapPower && (
              <span
                class="cast-power-layer is-tapped"
                data-power={member.tapPower}
              >
                <Fragment
                  set:html={renderPower(member.tapPower, member.facing)}
                />
              </span>
            )}
            {/* Both faces are rendered and one is hidden. Swapping the drawing
                at tap time would mean re-running the generator in the browser,
                which is a second copy of it shipped to every reader for a state
                two members ever reach. */}
            <span class="cast-face" data-mood={member.mood}>
              <Fragment
                set:html={renderMember({
                  hat: member.hat,
                  arms: true,
                  seated: member.seated,
                  mood: member.mood,
                  facing: member.facing,
                })}
              />
            </span>
            {member.tapMood && (
              <span class="cast-face is-tapped">
                <Fragment
                  set:html={renderMember({
                    hat: member.hat,
                    arms: true,
                    seated: member.seated,
                    mood: member.tapMood,
                    facing: member.facing,
                  })}
                />
              </span>
            )}
          </div>
        ))}
        {(cluster.pets ?? []).map((pet) => (
          <div
            class="cast-member is-pet"
            data-cast-pet
            data-idle="breathe"
            style={`--cast-dx: ${pet.dx}px; --cast-dy: ${pet.dy}px; --cast-size: ${pet.size}px; --cast-delay: ${cluster.delay}ms; --cast-offset: ${-cluster.phase}ms`}
          >
            <span class="cast-face">
              <Fragment set:html={renderPet(pet.kind, pet.mood, pet.facing)} />
            </span>
          </div>
        ))}
      </div>
    ))
  }
</div>

<style>
  /* The palette the page already has for figures. The dog fills at `#d4a574`
     and so does the airliner, neither inverts with the theme, and the design
     standard derives the palette from the artwork the site ships rather than
     from a value picked here. The cast is the third figure and had been the
     only one not in the family.
     
     It measures 2.03:1 against the light page and 7.96:1 against the dark one.
     The 3:1 a graphic answers to governs a meaningful one, and all three
     figures here are decoration hidden from assistive technology, so the
     shipped pair is the precedent rather than the exception. The eye takes the
     dog's own ink at 7.35:1 inside the body.
     
     Two earlier answers are retired. A brand fill was rejected for matching the
     employer marks at 1.10:1 in dark, and an inverting ink replaced it on the
     reading that no fixed color could clear 4.5:1 in both themes. That reading
     was sound and the floor was wrong: 4.5:1 is a text threshold and nothing
     here is text. */
  .cast-field {
    --cast-overhang: var(--power-overhang);
    --cast-body: #d4a574;
    --cast-eye: #2a1d14;
    /* The body fill carrying alpha rather than a second hue, so the power layer
       stays inside the one palette all three figures on the site share and
       still separates from the silhouette it sits behind. Alpha rather than a
       lighter tint because it resolves against both themes from one
       declaration, where a tint would need a value per theme and the family
       does not invert. */
    --cast-aura: color-mix(in oklab, var(--cast-body) 52%, transparent);
    /* The eye's own ink at a weight that stays behind the member. A standing
       shadow drawn in the aura fill is lighter than the figure casting it,
       which reads as a plate rather than as a second presence. */
    --cast-shade: color-mix(in oklab, var(--cast-eye) 34%, transparent);
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: none;
  }
  /* The rail's own breakpoint. Below it neither margin exists. */
  @media (min-width: 1280px) {
    .cast-field {
      display: block;
    }
  }

  /* Half the reading column, which is what a cluster anchors outward from. */
  .cast-cluster {
    --cast-column: 24rem;
    position: absolute;
    top: var(--cluster-top);
    width: var(--cluster-width);
  }
  .cast-cluster.is-left {
    right: calc(50% + var(--cast-column) + var(--cluster-gap));
  }
  .cast-cluster.is-right {
    left: calc(50% + var(--cast-column) + var(--cluster-gap));
  }

  /* Members sit at offsets from their cluster rather than from the page, which
     is what keeps a pair a pair at every width. */
  /* The field stays transparent to a pointer and the members do not, so a
     reader can reach a character without the empty margin around it swallowing
     a scroll or a selection. The cursor stays a default: a member plays back
     rather than leading anywhere, and a pointer cursor would promise a
     destination that does not exist. */
  /* A pet answers no pointer. It is scenery rather than a character a reader
     plays back, and giving it a reaction would make it a member with fewer
     legs. It keeps the shared class so the resting term reaches it. */
  .cast-member.is-pet {
    pointer-events: none;
  }
  .cast-member {
    pointer-events: auto;
    position: absolute;
    left: var(--cast-dx);
    top: var(--cast-dy);
    width: var(--cast-size);
    height: var(--cast-size);
    opacity: 0;
  }
  .cast-face {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Stacked under the member and grown by the reach its viewBox is padded
     with, so the member's own grid still lands on the member's own pixels. The
     inset is the reach as a share of the 12-cell grid, which is 25% at a reach
     of 3, and it is negative because the box grows outward from the member
     rather than the member shrinking inside it. */
  /* Swapped by the same `data-woken` the tapped face answers to, so a tap
     changes what a member emits and what it is feeling in one move. Only a tap
     sets that mark: a hover and the scheduler both run the reaction without it,
     which is what keeps a discharge something a reader causes. */
  .cast-power-layer.is-tapped {
    display: none;
  }
  .cast-member[data-woken] .cast-power-layer:not(.is-tapped) {
    display: none;
  }
  .cast-member[data-woken] .cast-power-layer.is-tapped {
    display: block;
  }
  .cast-power-layer {
    position: absolute;
    inset: calc(-1 * var(--cast-overhang) * 100%);
    display: block;
    pointer-events: none;
  }
  .cast-face.is-tapped {
    display: none;
  }
  .cast-member[data-woken] .cast-face:not(.is-tapped) {
    display: none;
  }
  .cast-member[data-woken] .cast-face.is-tapped {
    display: block;
  }
  .cast-member :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cast-field[data-arrived] .cast-member {
    opacity: 1;
  }

  /* Motion lives in `motion.css`, which the inventory harness reads as well. */
</style>

<script>
  import { hasHoverPointer } from '@/lib/pointer'

  // Arrival is gated on the section reaching the reader rather than on load, so
  // the spawn is something they cause by scrolling to it.
  const field = document.querySelector<HTMLElement>('[data-cast-field]')
  if (field) {
    // Hover reactions are gated on a device that reports a pointer, the same
    // test every other response on this site answers to. A touch pointer is
    // destroyed on lift, so a finger crossing a member on its way down the page
    // would leave it mid-reaction with nothing to end it.
    if (hasHoverPointer()) field.dataset.pointer = ''

    // A tap reaches what a hover cannot. It runs the same reaction on a class
    // the stylesheet already answers to, removed when the animation ends rather
    // than after a duration guessed here.
    /**
     * How long a tap holds when no animation carries it, which is every tap a
     * reduced-motion reader makes. Long enough to read the face that arrived
     * and short enough that the member is ready for the next tap.
     */
    const STILL_REACTION_MS = 1400

    // Nothing is left running, so the member goes back to its resting mood.
    const settle = (member: HTMLElement) => {
      delete member.dataset.reacting
      delete member.dataset.woken
      if (member.dataset.restReact !== undefined) {
        member.dataset.react = member.dataset.restReact
        delete member.dataset.restReact
      }
    }

    const isReacting = (member: HTMLElement) =>
      member.getAnimations({ subtree: true }).some((animation) => {
        const name = String(
          (animation as unknown as { animationName?: string }).animationName ?? '',
        )
        return (
          animation.playState === 'running' &&
          name.startsWith('cast-') &&
          name !== 'cast-breathe'
        )
      })

    for (const member of field.querySelectorAll<HTMLElement>('[data-cast-member]')) {
      member.addEventListener('click', () => {
        if (member.dataset.reacting !== undefined) return
        const tapped = member.dataset.reactTap
        if (tapped) {
          member.dataset.restReact = member.dataset.react ?? ''
          member.dataset.react = tapped
          member.dataset.woken = ''
        }
        member.dataset.reacting = ''

        // A reaction that starts no animation is never ended by one, since
        // `animationend` is the only thing that clears the mark. Every
        // `cast-*` keyframe sits behind `prefers-reduced-motion: no-preference`,
        // so a reader who asked for less motion is always in that state: the
        // member kept its tapped face, held its aura lit, and refused every
        // later tap for the life of the page.
        //
        // Held rather than released on the next frame. The face is the whole
        // of what a tap says once the movement is gone, and reverting it inside
        // a frame leaves that reader causing nothing they can see. The check
        // reads the animations rather than the media query, so a behavior that
        // ships without keyframes takes the same path.
        window.setTimeout(() => {
          if (!isReacting(member)) settle(member)
        }, STILL_REACTION_MS)
      })

      // Restored when nothing is left running rather than after a duration
      // guessed here. A reaction fires several animations of different lengths
      // and `animationend` arrives once per animation, so the first to finish
      // would cut the rest short.
      member.addEventListener('animationend', () => {
        if (isReacting(member)) return
        settle(member)
      })
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            field.dataset.arrived = ''
            observer.unobserve(entry.target)
          }
        },
        { threshold: 0.15 },
      )
      observer.observe(field)
    } else {
      // Without an observer the cast is placed rather than left invisible, since
      // the field is decoration and a reader loses nothing by meeting it settled.
      field.dataset.arrived = ''
    }

    /**
     * One member acts on its own every few seconds, and never two at once.
     *
     * `.claude/ARCHITECTURE.md` records expressive motion being moved to a
     * pointer on the reading that a margin full of characters performing at a
     * reader who has not looked at them is the ambient motion problem
     * restated. This does not reverse that. The band `.claude/DESIGN.md` bars
     * is *sustained* motion with no fixed reference, at 4 to 11px per second,
     * and every term here is a reaction that crosses it in a fraction of its
     * own cycle. What changes is who triggers one, not what a trigger runs.
     *
     * So the whole of it is a scheduler over the reactions that already exist.
     * It writes the same `data-reacting` a tap writes and the same
     * `animationend` clears it, which is why no keyframe and no selector moved
     * for this.
     */
    const SOLO_GAP_MS = 5200
    /** Spread, so the cast never settles into a countable rhythm. */
    const SOLO_JITTER_MS = 2600

    const members = [
      ...field.querySelectorAll<HTMLElement>('[data-cast-member]'),
    ]

    /**
     * Whether the section is on screen. A member acting behind the reader is
     * the ambient motion complaint with none of the payoff, and it is also the
     * only part of this that costs anything when nobody is looking.
     */
    let watching = false
    if ('IntersectionObserver' in window) {
      const presence = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) watching = entry.isIntersecting
        },
        { threshold: 0 },
      )
      presence.observe(field)
    }

    const stillMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

    const actOnce = () => {
      // A reader's own pointer outranks the schedule, and a member already
      // moving is what the one-at-a-time rule is about. Both are read off the
      // page rather than tracked, so nothing here can disagree with it.
      if (!watching || document.hidden || stillMotion.matches) return
      if (field.querySelector('[data-reacting]')) return
      if (field.querySelector('[data-cast-member]:hover')) return

      const idle = members.filter(
        (member) => member.dataset.reacting === undefined,
      )
      if (idle.length === 0) return

      const chosen = idle[Math.floor(Math.random() * idle.length)]
      chosen.dataset.reacting = ''

      // A term that starts no animation is never ended by one, which is the
      // trap the tap path already carries. Here it costs more, because a
      // member left marked would take the scheduler's one slot for the life of
      // the page and the cast would go quiet with nothing saying why.
      window.setTimeout(() => {
        if (!isReacting(chosen)) settle(chosen)
      }, STILL_REACTION_MS)
    }

    const schedule = () => {
      window.setTimeout(
        () => {
          actOnce()
          schedule()
        },
        SOLO_GAP_MS + Math.random() * SOLO_JITTER_MS,
      )
    }
    schedule()
  }
</script>
