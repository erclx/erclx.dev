---
import { Image } from 'astro:assets'
import ThemeToggle from '@/components/site/theme-toggle/theme-toggle.astro'
import { getLinkTargetAttributes } from '@/lib/links'
import shaderFieldFallback from './shader-field/fallback.svg?raw'
import portrait from '@/assets/header/portrait.jpg'

const links = [
  { label: 'GitHub', href: 'https://github.com/erclx' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/erclx' },
  { label: 'me@erclx.dev', href: 'mailto:me@erclx.dev' },
]
---

{/* The band holds a share of the viewport below md rather than only the
    content's own height, where it read as a squeezed header rather than the
    stage it is. It stops short of the full screen a wider viewport gets,
    because a phone reader would otherwise scroll a whole screen before meeting
    anything. The unit is `svh` rather than `vh`: a collapsing address bar grows
    `vh` mid-scroll, which would overflow the band it is meant to bound.

    From md the band splits its free space two parts above the column to three
    below rather than evenly, so the name sits where a reader's eye rests
    instead of on the halfway line. Centring held the column at 52% of the
    viewport and drifted further down as the screen grew taller, because fixed
    paddings distribute the surplus evenly and a taller screen has more of it.
    A ratio is invariant to that: the name holds 37% at 1280x800 and 38% at
    1920x1080 where centring ran 43% and 44%. Below md the column already sits
    at 26% inside a band that is 70svh rather than the full screen, so the
    ratio would push it off the top of its own band. */}
<header
  data-section="header"
  class="bg-secondary relative flex min-h-[70svh] items-center overflow-hidden page-inset pt-20 pb-16 md:grid md:min-h-screen md:grid-rows-[2fr_auto_3fr] md:pt-32 md:pb-20"
>
  {/* The canvas renders under reduced motion too, holding a single drawn frame
      rather than hiding for an authored stand-in. One surface then answers both
      preferences and neither can drift from the other. */}
  <canvas
    data-shader-field
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 size-full"
  ></canvas>
  {/* Reached only where WebGL is missing or its context is lost, which the
      mount reveals by hand. A band with nothing behind it reads as a broken
      page rather than a quiet one. */}
  <div
    data-shader-field-fallback
    aria-hidden="true"
    class="text-foreground pointer-events-none absolute inset-0 hidden size-full [&>svg]:size-full"
    set:html={shaderFieldFallback}
  >
  </div>
  {/* The band's ground fades into the page's rather than stopping on an edge.
      The hero is a lighter plate than the page in both themes, so a rounded
      corner against a flat section read as a card laid on a different
      document. Fading the plate out removes it where softening its corner
      only made the same edge rounder. The contour field thins with it, since
      the canvas paints under this.

      Shorter below md, where the band holds 70svh rather than the screen and a
      desktop-sized fade would take two fifths of it. */}
  <div
    data-hero-fade
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-40 md:h-60"
  >
  </div>
  {/* The toggle sits in the header's own corner. Its old home was the greeting
      row, and the greeting moved under the name, where the portrait floats
      flush to the column's right edge for 160px from the heading's top and
      covers every row below it.

      The corner is 28px above the bar's slot and 216px to the right of it,
      because it aligns to the viewport where the bar aligns to the content
      column. `hero-handoff.ts` crosses that gap on the name's travel rather
      than on the vertical one, so moving this anchor changes how far the
      control has to go and not how long it takes. Below md the column is
      wider than the viewport and the two coincide, so nothing crosses. */}
  <div data-hero-toggle-home class="absolute top-6 right-6 md:top-10 md:right-10">
    <ThemeToggle />
  </div>
  {/* The shader reads this box and damps its field inside it, so the surface
      never competes with the name. The column rather than the heading, since
      the links sit at the bottom of it and take the least contrast. */}
  <div
    data-header-column
    data-shader-content
    class="relative mx-auto w-full max-w-3xl md:row-start-2"
  >
    <div>
      <div>
        <div data-fade style="--fade-delay: 150ms">
          {/* The portrait floats inside the heading, so its top is the heading's
              own top at every width rather than a sum of the elements that
              happen to sit above it. Its alt stays empty because alt text on an
              image inside a heading prepends to that heading's accessible name,
              and the heading already states the name. */}
          <h1 class="font-display text-display text-foreground">
            <Image
              src={portrait}
              alt=""
              widths={[112, 160, 320]}
              sizes="(min-width: 1024px) 10rem, (min-width: 768px) 7rem, 5rem"
              data-portrait
              class="border-border/60 bg-muted float-right ml-6 size-20 rounded-full border object-cover md:size-28 lg:size-40"
            />
            {/* Only the text travels into the sticky bar. The portrait floats
                inside this heading and stays with the hero, so the name is its
                own element rather than the whole line. */}
            <span data-hero-name>Eric Le</span>
          </h1>
        </div>
        <div data-fade style="--fade-delay: 300ms">
          {/* The greeting sits under the name rather than over it, so one line
              does both jobs: it still opens the page and it now frames the
              links, which stood bare under the name with nothing introducing
              them. The name leading is what makes the surface read as an
              introduction rather than as a subtitle over a heading.

              It takes the display face at the lede step, so the two lines read
              as one masthead rather than as a heading with a caption beneath
              it. The location left this surface rather than moving here: the
              closing ask already states it as a filter.

              The margin reads small against the gap under the line because the
              display step's line box carries about 25px of leading below its
              baseline. Optically the two gaps are 33.5px and 28px, which is
              what makes the three lines read as one block rather than as a
              name and a separate pair. Measured at 1280 on 2026-08-19. */}
          <p
            data-hero-line
            class="font-display text-lede text-muted-foreground mt-2"
          >
            Welcome, this is my corner of the internet.
          </p>
          <ul class="mt-3 flex flex-wrap gap-x-6">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...getLinkTargetAttributes(link.href)}
                    class="text-foreground text-label inline-flex min-h-11 min-w-11 items-center underline-offset-4 hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* Stops follow smoothstep rather than a straight ramp, so the fade's slope
     reaches zero at both ends instead of stopping dead.

     A linear ramp meeting a flat field carries no step in value at all: the
     join measures a luminance gap of 0.00. What it carries is a break in
     slope, falling about 7 units per 100px and then holding exactly 0, and the
     eye reports an edge at a slope break whether or not a value break is
     there. Easing removes the break rather than lengthening the ramp, which
     would only move the same edge further up the band. */
  [data-hero-fade] {
    background: linear-gradient(
      to bottom,
      rgb(from var(--background) r g b / 0) 0%,
      rgb(from var(--background) r g b / 0.003) 3.125%,
      rgb(from var(--background) r g b / 0.011) 6.25%,
      rgb(from var(--background) r g b / 0.04) 12.5%,
      rgb(from var(--background) r g b / 0.16) 25%,
      rgb(from var(--background) r g b / 0.32) 37.5%,
      rgb(from var(--background) r g b / 0.5) 50%,
      rgb(from var(--background) r g b / 0.68) 62.5%,
      rgb(from var(--background) r g b / 0.84) 75%,
      rgb(from var(--background) r g b / 0.96) 87.5%,
      rgb(from var(--background) r g b / 0.989) 93.75%,
      rgb(from var(--background) r g b / 0.997) 96.875%,
      var(--background) 100%
    );
  }
</style>

<script>
  import { initShaderField } from './shader-field'

  initShaderField()
</script>
