---
import { Image } from 'astro:assets'
import ThemeToggle from '@/components/site/theme-toggle/theme-toggle.astro'
import { getLinkTargetAttributes } from '@/lib/links'
import flowFieldFallback from './flow-field/fallback.svg?raw'
import portrait from '@/assets/header/portrait.jpg'

const links = [
  { label: 'GitHub', href: 'https://github.com/erclx' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/erclx' },
  { label: 'me@erclx.dev', href: 'mailto:me@erclx.dev' },
]
---

<header
  data-section="header"
  class="bg-secondary relative flex overflow-hidden rounded-b-3xl px-6 pt-20 pb-16 md:min-h-screen md:items-center md:pt-32 md:pb-20"
>
  <canvas
    data-flow-field
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 size-full motion-reduce:hidden"
  ></canvas>
  <div
    data-flow-field-fallback
    aria-hidden="true"
    class="text-foreground pointer-events-none absolute inset-0 hidden size-full motion-reduce:block [&>svg]:size-full"
    set:html={flowFieldFallback}
  >
  </div>
  <div data-header-column class="relative mx-auto w-full max-w-3xl">
    <div>
      <div data-fade>
        {/* The toggle shares the identity row but sits out of its flow, so its
            tap height cannot displace the line it centres on. Nothing reserves
            space for it: the line beside it is one short label. */}
        <div class="relative">
          {/* The location left this surface rather than moving here. The
              closing ask already states it as a filter, so repeating it above
              would be the same fact in two places. */}
          <p data-hero-line class="text-muted-foreground text-label">
            Welcome, this is my corner of the internet.
          </p>
          <div
            data-hero-toggle-home
            class="absolute top-1/2 right-0 -translate-y-1/2"
          >
            <ThemeToggle />
          </div>
        </div>
      </div>
      <div>
        <div data-fade style="--fade-delay: 150ms">
          {/* The portrait floats inside the heading, so its top is the heading's
              own top at every width rather than a sum of the elements that
              happen to sit above it. Its alt stays empty because alt text on an
              image inside a heading prepends to that heading's accessible name,
              and the heading already states the name. */}
          <h1 class="font-display text-display text-foreground mt-6">
            <Image
              src={portrait}
              alt=""
              widths={[112, 160, 320]}
              sizes="(min-width: 1024px) 10rem, (min-width: 768px) 7rem, 5rem"
              data-portrait
              class="border-border/60 bg-muted float-right ml-6 size-20 rounded-full border object-cover md:size-28 lg:size-40"
            />
            {/* Only the text travels into the sticky bar. The portrait floats
                inside this heading and stays with the hero, so the name is its
                own element rather than the whole line. */}
            <span data-hero-name>Eric Le</span>
          </h1>
        </div>
        <div data-fade style="--fade-delay: 300ms">
          <ul class="mt-8 flex flex-wrap gap-x-6">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...getLinkTargetAttributes(link.href)}
                    class="text-foreground text-label inline-flex min-h-11 min-w-11 items-center underline-offset-4 hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { initFlowField } from './flow-field'

  initFlowField()
</script>
