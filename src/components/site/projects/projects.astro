---
import ProjectCard from './project-card.astro'
import aitkPoster from '@/assets/projects/aitk.png'
import jobtriagePoster from '@/assets/projects/jobtriage.png'
import stackrPoster from '@/assets/projects/stackr.png'
import caretPoster from '@/assets/projects/caret.png'
import dictionPoster from '@/assets/projects/diction.png'
import jobtriageVideo from '@/assets/videos/jobtriage.mp4?url'
import stackrVideo from '@/assets/videos/stackr.mp4?url'
import caretVideo from '@/assets/videos/caret.mp4?url'

// Each card names the route it owns as its own field. It used to be derived by
// picking the one internal href out of the links list, which stopped working
// the moment the route stopped being a link in it. The links are now what they
// say they are: where the artifact itself lives.
const projects = [
  {
    name: 'aitk',
    route: '/aitk',
    description:
      'CLI that installs one set of agent rules, skills, and standards into every project and keeps them in step. Installs from npm as @erclx/aitk and as a Claude Code plugin.',
    poster: aitkPoster,
    mediaAlt:
      'aitk — terminal transcript of the install command running in a project',
    mediaPosition: 'left top',
    links: [
      { label: 'GitHub', href: 'https://github.com/erclx/aitk' },
      { label: 'npm', href: 'https://www.npmjs.com/package/@erclx/aitk' },
    ],
  },
  {
    name: 'Jobtriage',
    route: '/jobtriage',
    description:
      'Live agent that triages Swedish job ads against a profile. Reachable at jobtriage.erclx.dev without a key, and the case study carries the retrieval numbers.',
    poster: jobtriagePoster,
    videoSrc: jobtriageVideo,
    mediaAlt:
      'Jobtriage, chat interface with retrieved ad cards on a React Flow canvas',
    links: [
      { label: 'Live demo', href: 'https://jobtriage.erclx.dev' },
      { label: 'GitHub', href: 'https://github.com/erclx/jobtriage' },
    ],
  },
  {
    name: 'Stackr',
    route: '/stackr',
    description:
      'VS Code extension that stages files across a workspace into one block of LLM context. Installed from the VS Code Marketplace and Open VSX.',
    poster: stackrPoster,
    videoSrc: stackrVideo,
    mediaAlt: 'Stackr — VS Code panel showing staged files and a context preview',
    mediaPosition: 'left top',
    links: [
      {
        label: 'VS Code Marketplace',
        href: 'https://marketplace.visualstudio.com/items?itemName=erclx.ai-context-stacker',
      },
      {
        label: 'Open VSX',
        href: 'https://open-vsx.org/extension/erclx/ai-context-stacker',
      },
      { label: 'GitHub', href: 'https://github.com/erclx/stackr' },
    ],
  },
  {
    name: 'Caret',
    route: '/caret',
    description:
      'Chrome extension that saves prompts and drops them into Claude, Gemini, and ChatGPT from the chat input. Live on the Chrome Web Store.',
    poster: caretPoster,
    videoSrc: caretVideo,
    mediaAlt: 'Caret — chat input showing a trigger-character palette of saved prompts',
    links: [
      {
        label: 'Chrome Web Store',
        href: 'https://chromewebstore.google.com/detail/caret/bpmdbibldelkpncegllkeegdpblgehgk',
      },
      { label: 'GitHub', href: 'https://github.com/erclx/caret' },
    ],
  },
  {
    name: 'diction',
    route: '/diction',
    description:
      'Pronunciation trainer that scores each sound against what a native speaker actually sounds like, and reports how often it is wrong. Runs offline with nothing leaving the machine.',
    poster: dictionPoster,
    mediaAlt:
      'diction — a scored passage reading, with the word thought flagged and the th correction shown',
    mediaPosition: 'left top',
    links: [
      { label: 'GitHub', href: 'https://github.com/erclx/diction' },
    ],
  },
]

// The route each card owns, held as its own field rather than found among the
// links. It was derived by picking the one internal href out of that list,
// which stopped working the moment the route stopped being a link in it.
---

<section id="projects" data-section="projects" class="page-inset py-16 md:py-20">
  <div class="mx-auto max-w-3xl lg:max-w-5xl">
    <h2
      data-fade
      class="font-display text-foreground section-heading leading-tight font-semibold"
    >
      Projects
    </h2>
    {/* The gutter carries the separation the plate used to. It also has to
        clear the halo a hover raises: at a 24px gutter the halo's own box
        reached the neighboring card exactly, and its shadow crossed about
        36px into it, so pointing at one card lit the one beside it. */}
    <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-2">
      {
        projects.map((project, index) => {
          const numeral = String(index + 1).padStart(2, '0')
          const isLeftCol = index % 2 === 0
          const fadeDelay = `${index * 200}ms`
          // An odd count leaves the last card alone in a two-column row, so it
          // closes the section across both columns instead.
          const isWide = projects.length % 2 === 1 && index === projects.length - 1
          return (
            <div
              data-project-frame
              class:list={['relative', isWide && 'lg:col-span-2']}
            >
              <span
                aria-hidden="true"
                data-fade
                style={`--fade-delay: ${fadeDelay}`}
                class:list={[
                  'font-display pointer-events-none absolute z-10 leading-none font-semibold select-none',
                  'top-3 right-5 text-[5rem] text-stone-500/50 dark:text-foreground/12',
                  'lg:top-0 lg:text-[8rem] lg:text-stone-500/65 lg:dark:text-foreground/15',
                  isLeftCol
                    ? 'lg:right-auto lg:-left-12'
                    : 'lg:left-auto lg:-right-12',
                ]}
              >
                {numeral}
              </span>
              <ProjectCard
                name={project.name}
                description={project.description}
                poster={project.poster}
                videoSrc={project.videoSrc}
                mediaAlt={project.mediaAlt}
                mediaPosition={project.mediaPosition}
                links={project.links}
                caseStudyHref={project.route}
                index={index}
                isWide={isWide}
              />
            </div>
          )
        })
      }
    </div>
  </div>
</section>

<script>
  import { initHoverVideo } from '@/lib/hover-video'
  import { initReveal } from '@/lib/reveal'

  import { initTilt } from './tilt'

  initReveal()
  initHoverVideo()
  initTilt()
</script>
