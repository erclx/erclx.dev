---
import Employers from '@/components/site/experience/employers.astro'

const intro = [
  'In practice that means agents, and the developer tools around them. Some of that was paid work, eighteen months of it at Volvo Technology, and the rest is tools I have built to make working with AI easier. I came to it from engineering physics and complex adaptive systems at Chalmers.',
  'I spend most of my working day with coding agents, and the tooling I build comes out of that. When the same rules kept drifting out of sync across my projects, that became a CLI. When staging files for a prompt got tedious, that became an extension.',
]

interface HistoryEntry {
  current?: boolean
  span: string
  head: string
  // A beat holding two pieces of work carries a line for each, which is why
  // this is a list rather than the single sentence the others need.
  details: string[]
}

const history: HistoryEntry[] = [
  {
    current: true,
    span: 'jan 2026 to present',
    head: 'shipping independently, open to the next thing',
    details: [
      'Each project below answers a problem I ran into.',
    ],
  },
  {
    span: 'jun to dec 2025',
    head: 'working out what to build',
    details: [
      'Took the time to learn TypeScript and web application development, and to work out where to point AI next.',
    ],
  },
  {
    span: 'jan 2024 to jun 2025',
    head: 'volvo technology, gothenburg',
    details: [
      'The job was an agent that let engineering teams plot and query truck data by asking in plain language.',
      'It started as my master’s thesis and became a multi-step SQL pipeline with session memory.',
    ],
  },
  {
    span: 'jun to aug 2023',
    head: 'internship at bac ha software, hanoi',
    details: [
      'Reproduced published GAN architectures in TensorFlow for image inpainting and pre-trained them on GPU.',
    ],
  },
  {
    span: 'sep 2022 to jun 2024',
    head: 'msc in complex adaptive systems, chalmers',
    details: [
      'How simple agents and their environment produce behavior nobody designed.',
    ],
  },
  {
    span: 'sep 2019 to jun 2022',
    head: 'bsc in engineering physics, chalmers',
    details: [
      'Where the modelling habits came from, before any of this was software.',
    ],
  },
]

// The chips name the cards in the projects section below, in their rendered
// order, since those artifacts are what the newest beat produced. An e2e test
// compares the two lists so a card added there cannot drift from this one.
const artifacts = [
  { label: 'aitk', href: '#aitk' },
  { label: 'Jobtriage', href: '#jobtriage' },
  { label: 'Stackr', href: '#stackr' },
  { label: 'Caret', href: '#caret' },
  { label: 'diction', href: '#diction' },
]
---

<section id="experience" data-section="experience" class="page-inset py-16 md:py-20">
  <div class="mx-auto max-w-3xl">
    <h2
      data-fade
      class="font-display text-foreground section-heading leading-tight font-semibold"
    >
      Experience
    </h2>

    {/* The claim leads this section rather than the hero, and its elaboration
        follows it here because that paragraph opens on a pronoun standing for
        the claim. Splitting the two across surfaces left the pronoun with no
        antecedent on either. */}
    <p
      data-fade
      style="--fade-delay: 100ms"
      class="font-display text-foreground mt-8 text-3xl leading-tight md:text-4xl"
    >
      I build <span data-annotate="underline">the layer</span> between a language
      model and the job it has to do.
    </p>

    <div class="mt-8 space-y-6">
      {
        intro.map((paragraph, idx) => (
          <p
            data-fade
            style={`--fade-delay: ${200 + idx * 100}ms`}
            class="text-muted-foreground text-body"
          >
            {paragraph}
          </p>
        ))
      }
    </div>

    <Employers />

    {/* The list opened on `Newest first.` until the spans moved into a column
        of their own. That line existed because the dates were buried inside the
        head sentences, so the order was not visible; a reader now meets 2026
        against jun to dec 2025 against jan 2024 down one edge, and the list
        states its own order. A line explaining what the reader can already see
        is the one kind of caption worth deleting. */}
    <div class="experience-stage mt-10 lg:mt-14">
      <ol class="experience-list flex flex-col">
        {
          history.map((entry, idx) => (
            <li
              data-fade
              data-default-active={entry.current ? 'true' : undefined}
              aria-current={entry.current ? 'step' : undefined}
              style={`--fade-delay: ${500 + idx * 100}ms`}
              class="experience-row text-body grid grid-cols-[1fr] items-start md:grid-cols-[11.5rem_3.25rem_1fr]"
            >
              <p class="experience-date tabular-nums">{entry.span}</p>
              <span class="experience-gutter" aria-hidden="true">
                <span class="experience-marker-line">
                  <span class="experience-marker"></span>
                </span>
              </span>
              <div>
                <p class="experience-head">{entry.head}</p>
                {entry.details.map((detail) => (
                  <p class="experience-detail text-label mt-2 font-sans">{detail}</p>
                ))}
                {entry.current && (
                  <ul class="mt-3 flex flex-wrap gap-x-2">
                    {artifacts.map((artifact) => (
                      <li>
                        <a href={artifact.href} class="experience-chip-hit">
                          <span class="experience-chip text-label">
                            {artifact.label}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .experience-list {
    --experience-beat-gap: 1.75rem;
  }
  .experience-row {
    color: var(--muted-foreground);
    padding-bottom: var(--experience-beat-gap);
    position: relative;
    isolation: isolate;
  }
  /* The beat a pointer is on lifts onto the site's glow, which is what every
     other bounded surface does and what the closing ask already carries.
     Drawn behind the row and inset outward, so the list carries no plate at rest.
     It covers the date and the gutter as well as the text: the three are one
     beat, and plating two of them separated a date from its own row.

     The rail keeps painting over it. Its line lives on the gutter, which is a
     descendant of the row, so it sits above a plate held at a negative index
     and reads as running behind a raised beat rather than as a line drawn
     across a card. */
  .experience-row::after {
    content: '';
    position: absolute;
    inset: -0.35rem -1.25rem;
    border-radius: 0.85rem;
    z-index: -1;
    opacity: 0;
    background: var(--glow-fill);
    box-shadow: var(--glow-shadow);
  }
  /* Keyed to the beat the list currently marks rather than to the pointer, so
     the plate travels with the dot when the list walks back to its resting
     beat. On `:hover` alone the plate stayed on the row the pointer left and
     faded there while the dot moved on, which lit two rows by two different
     means at once: measured 160ms after leaving, the dot was two beats away
     from a plate still at 0.66.

     The stage carries the engagement flag, so the plate leaves once the walk
     settles. Keying it to the active row alone would put a permanent plate
     under the current beat, which is lit from first paint. */
  .experience-stage[data-engaged='true'] .experience-row[data-active='true']::after {
    opacity: 1;
  }
  .experience-row:last-child {
    padding-bottom: 0;
  }
  /* Two derived positions carry the rail. The dot centres inside a box one line
     tall, so it lands on the row's first line whatever the type scale does, and
     each segment runs from that centre to the next row's, reaching it by the
     one gap value the rows are spaced with. No offset is measured or written. */
  .experience-gutter {
    position: relative;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .experience-marker-line {
    display: flex;
    align-items: center;
    height: 1lh;
  }
  .experience-row:not(:last-child) .experience-gutter::after {
    content: '';
    position: absolute;
    top: calc(1lh / 2);
    bottom: calc(-1 * (var(--experience-beat-gap) + 1lh / 2));
    width: 1px;
    background: var(--border);
  }
  /* The oldest beat trails off rather than stopping at its dot, so the record
     reads as continuing behind the first entry. */
  .experience-row:last-child .experience-gutter::after {
    content: '';
    position: absolute;
    top: calc(1lh / 2);
    height: var(--experience-beat-gap);
    width: 1px;
    background: linear-gradient(to bottom, var(--border), transparent);
  }
  .experience-date {
    color: var(--muted-foreground);
  }
  /* Below md the row is one column, so the date leads its own block rather
     than sitting in a gutter the layout no longer has. */
  @media (max-width: 767px) {
    .experience-date {
      margin-bottom: 0.25rem;
    }
    .experience-gutter {
      display: none;
    }
  }
  .experience-detail {
    color: var(--muted-foreground);
    line-height: 1.65;
  }
  .experience-marker {
    position: relative;
    display: block;
    width: 0.62em;
    height: 0.62em;
    border-radius: 9999px;
    border: 1.5px solid currentColor;
    background-color: var(--background);
    box-sizing: border-box;
    flex-shrink: 0;
  }
  .experience-row[data-default-active='true'],
  .experience-row[data-active='true'] {
    color: var(--foreground);
  }
  .experience-row[data-default-active='true'] .experience-marker,
  .experience-row[data-active='true'] .experience-marker {
    background-color: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 18%, transparent);
  }
  /* The link carries the phone tap minimum the landing page holds every link
     to, and the pill inside it draws at the height the row wants. Sizing the
     pill itself to 44px made it read as a button among log lines. */
  .experience-chip-hit {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    justify-content: center;
  }
  .experience-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 9999px;
    padding: 0.2rem 0.75rem;
    color: var(--muted-foreground);
  }
  /* A chip has its own bounds, so it takes the glow the project cards carry
     rather than the border-and-color answer it shared with the rail until
     that rail gained a ground of its own. */
  .experience-chip-hit:hover .experience-chip,
  .experience-chip-hit:focus-visible .experience-chip {
    border-color: var(--accent);
    color: var(--foreground);
    background: var(--glow-fill);
    box-shadow: var(--glow-shadow);
  }
  @media (prefers-reduced-motion: no-preference) {
    .experience-row,
    .experience-marker {
      transition:
        color 150ms ease-out,
        background-color 150ms ease-out,
        border-color 150ms ease-out,
        box-shadow 200ms ease-out;
    }
    /* The site's own pair, so a pointer crossing the beats trails the way it
       does crossing the project grid and the closing ask. */
    .experience-row::after {
      transition: opacity var(--glow-out) ease-out;
    }
    .experience-stage[data-engaged='true'] .experience-row[data-active='true']::after {
      transition: opacity var(--glow-in) ease-out;
    }
    /* The chip leaves on the site's shared glow timing rather than its own,
       so a pointer crossing the row of chips trails the same way it does
       crossing the project grid. */
    .experience-chip {
      transition:
        color 150ms ease-out,
        border-color 150ms ease-out,
        background-color var(--glow-out) ease-out,
        box-shadow var(--glow-out) ease-out;
    }
    .experience-chip-hit:hover .experience-chip,
    .experience-chip-hit:focus-visible .experience-chip {
      transition:
        color 150ms ease-out,
        border-color 150ms ease-out,
        background-color var(--glow-in) ease-out,
        box-shadow var(--glow-in) ease-out;
    }
  }
</style>

<script>
  import { initAnnotations } from '@/lib/annotate'

  initAnnotations()

  const stage = document.querySelector<HTMLElement>('.experience-stage')
  const list = stage?.querySelector<HTMLOListElement>('.experience-list')
  if (stage && list) {
    const rows = Array.from(list.querySelectorAll<HTMLLIElement>('.experience-row'))
    const defaultIdx = Math.max(
      0,
      rows.findIndex((r) => r.dataset.defaultActive === 'true'),
    )
    let activeIdx = defaultIdx
    let walkTimer: number | null = null

    const setActive = (idx: number) => {
      rows[activeIdx]?.removeAttribute('data-active')
      rows[idx]?.setAttribute('data-active', 'true')
      activeIdx = idx
    }

    const cancelWalk = () => {
      if (walkTimer !== null) {
        window.clearTimeout(walkTimer)
        walkTimer = null
      }
    }

    rows[defaultIdx]?.removeAttribute('data-default-active')
    setActive(defaultIdx)

    for (const [i, row] of rows.entries()) {
      row.addEventListener('pointerenter', () => {
        cancelWalk()
        stage.dataset.engaged = 'true'
        setActive(i)
      })
    }

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // The walk lingers on the beat a reader chose and gathers pace as it
    // returns to the current one, which is why the first step is the slow one.
    // It depicts letting go of a beat rather than traveling to another, so the
    // moment worth holding is the leaving. The reverse shipped first and rushed
    // exactly that, then eased into a beat nobody had asked about.
    //
    // It also thins the trail where the trail is thickest. The plate follows
    // the marked beat and leaves over its own 520ms, so the slow steps falling
    // first give each plate room to clear while the most of them are lit.
    //
    // Judged against an even cadence, the reverse, and a curve slow at both
    // ends, all served live at four paces.
    const firstStepDelay = 160
    const lastStepDelay = 40
    const stepDelay = (progress: number): number =>
      firstStepDelay - progress * progress * (firstStepDelay - lastStepDelay)

    stage.addEventListener('pointerleave', () => {
      cancelWalk()
      if (reduce || activeIdx === defaultIdx) {
        setActive(defaultIdx)
        delete stage.dataset.engaged
        return
      }
      const startDistance = Math.abs(activeIdx - defaultIdx)
      const step = activeIdx > defaultIdx ? -1 : 1
      let stepsTaken = 0

      const scheduleNext = () => {
        const progress = stepsTaken / startDistance
        const delay = stepDelay(progress)
        walkTimer = window.setTimeout(() => {
          setActive(activeIdx + step)
          stepsTaken += 1
          if (activeIdx === defaultIdx) {
            walkTimer = null
            delete stage.dataset.engaged
          } else {
            scheduleNext()
          }
        }, delay)
      }

      scheduleNext()
    })
  }
</script>
