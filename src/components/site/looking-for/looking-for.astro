            stroke-linecap="round"
            fill="none"
          />
        </svg>
      </div>

      <div
        class="looking-rows border-border/60 bg-background relative z-10 border-t pt-8"
      >
        <dl class="grid gap-y-3">
          {
            criteria.map((item, idx) => (
              <div
                data-fade
                style={`--fade-delay: ${150 + idx * 100}ms`}
                class="group -ml-4 grid items-baseline gap-x-6 border-l-2 border-transparent py-1 pl-4 hover:border-accent sm:grid-cols-[13rem_1fr]"
              >
                <dt class="text-muted-foreground group-hover:text-foreground text-label">
                  {item.label}
                </dt>
                <dd class="text-muted-foreground group-hover:text-foreground text-body">
                  {item.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  /* The slot rests on the label's baseline and stands one cap height tall, so
     the dot inside it centres on the capitals rather than on the line box. The
     descender space under the baseline is empty and still counts toward a line
     box's middle. */
  .status-dot-slot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1cap;
  }
  /* The dot takes the size and the ring the origin section's active marker
     carries, so the two read as one shape language. The color stays its own:
     green states availability where the accent states position. */
  .status-dot {
    position: relative;
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 9999px;
    background-color: var(--chart-2);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--chart-2) 18%, transparent);
  }
  /* The halo is a pseudo-element so the pulse never changes the dot's own box
     and nothing on the status line reflows on it. */
  @media (prefers-reduced-motion: no-preference) {
    .status-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background-color: var(--chart-2);
      animation: status-ping 2400ms cubic-bezier(0.2, 0, 0.4, 1) infinite;
    }
    @keyframes status-ping {
      from {
        opacity: 0.5;
        transform: scale(1);
      }
      70% {
        opacity: 0;
        transform: scale(2.6);
      }
      to {
        opacity: 0;
        transform: scale(2.6);
      }
    }
  }
  .looking-peek {
    transform: translateY(5%);
    transition: transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .looking-stage[data-peek-visible='true'] .looking-peek {
    transform: translateY(-73%);
  }
  .looking-stage[data-peek-visible='true'][data-peek-ducked='true']
    .looking-peek {
    transform: translateY(5%);
    transition: transform 350ms ease-in;
  }
  @media (prefers-reduced-motion: reduce) {
    .looking-peek {
      transform: translateY(-73%);
      transition: none;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.looking-stage')
  const rows = stage?.querySelector<HTMLElement>('.looking-rows')
  if (stage && rows) {
    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              stage.dataset.peekVisible = 'true'
              observer.unobserve(entry.target)
            }
          }
        },
        { threshold: 0.4 },
      )
      observer.observe(stage)
    } else {
      stage.dataset.peekVisible = 'true'
    }

    if (!reduce) {
      rows.addEventListener('pointerenter', () => {
        stage.dataset.peekDucked = 'true'
      })
      rows.addEventListener('pointerleave', () => {
        delete stage.dataset.peekDucked
      })
    }
  }
</script>
