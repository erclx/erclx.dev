---
import '@/styles/global.css'
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url'
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'

import SiteBar from '@/components/site/nav/site-bar.astro'

interface Props {
  title: string
  description: string
  // A route naming its surface lets the stylesheet scope tokens to it. The
  // landing page names none, so its measure and type stay where they are.
  surface?: 'case-study'
}

const { title, description, surface } = Astro.props
const isRoute = surface === 'case-study'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href={frauncesUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={interUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      const stored = localStorage.getItem('theme')
      const mode =
        stored === 'light' || stored === 'dark' || stored === 'system'
          ? stored
          : 'system'
      const prefersDark = window.matchMedia(
        '(prefers-color-scheme: dark)',
      ).matches
      if (mode === 'dark' || (mode === 'system' && prefersDark)) {
        document.documentElement.classList.add('dark')
      }
      document.documentElement.dataset.themeMode = mode
      document.documentElement.dataset.js = 'true'
    </script>
  </head>
  <body
    class:list={[
      'bg-background text-foreground font-sans antialiased',
      surface && `surface-${surface}`,
    ]}
  >
    {/* A route already renders a top bar of its own, which the stylesheet
        makes sticky. Only the landing page needs one mounted, so the two never
        stack. */}
    {!isRoute && <SiteBar />}
    <slot />
  </body>
</html>
