---
import annexPosterDark from '@/assets/projects/annex-dark.png'
import annexPoster from '@/assets/projects/annex-light.png'
import canonPoster from '@/assets/projects/canon-agent-view.png'
import caretPoster from '@/assets/projects/caret.png'
import jobtriagePoster from '@/assets/projects/jobtriage.png'
import stackrPoster from '@/assets/projects/stackr.png'
import canonVideo from '@/assets/videos/canon.mp4?url'
import caretVideo from '@/assets/videos/caret.mp4?url'
import jobtriageVideo from '@/assets/videos/jobtriage.mp4?url'
import stackrVideo from '@/assets/videos/stackr.mp4?url'

import ProjectCard from './project-card.astro'

// Each card names the route it owns as its own field. It used to be derived by
// picking the one internal href out of the links list, which stopped working
// the moment the route stopped being a link in it. The links are now what they
// say they are: where the artifact itself lives.
const projects = [
  {
    name: 'canon',
    route: '/canon',
    description:
      'Rules and workflows kept drifting across every project I had. I built a CLI and Claude Code plugin that distributes them from one source, carries the plan, review, and ship loop as skills, and coordinates parallel work across separate branches. Available on npm as @erclx/canon, with a live build at canon.erclx.dev.',
    poster: canonPoster,
    videoSrc: canonVideo,
    mediaAlt:
      "canon's landing page, one real session the toolkit ran on itself",
    links: [
      { label: 'GitHub', href: 'https://github.com/erclx/canon' },
      { label: 'npm', href: 'https://www.npmjs.com/package/@erclx/canon' },
      { label: 'Live build', href: 'https://canon.erclx.dev' },
    ],
  },
  {
    name: 'Jobtriage',
    route: '/jobtriage',
    description:
      'I was job hunting, and Sweden\'s job API is public. So I built against it. A job-search application that triages Swedish ads against a profile, with a public demo and the retrieval numbers in the case study.',
    poster: jobtriagePoster,
    videoSrc: jobtriageVideo,
    mediaAlt:
      'Jobtriage, chat interface with retrieved ad cards on a React Flow canvas',
    links: [
      { label: 'Live demo', href: 'https://jobtriage.erclx.dev' },
      { label: 'GitHub', href: 'https://github.com/erclx/jobtriage' },
    ],
  },
  {
    name: 'annex',
    route: '/annex',
    description:
      'I wanted to know whether retrieval still helped when a model could read the whole EU AI Act. A compliance agent that maps a described system to cited articles, with a case study comparing full-context reading, vector search, and graph traversal.',
    poster: annexPoster,
    posterDark: annexPosterDark,
    mediaAlt:
      'The Annex landing page: a description box and twelve recorded questions',
    links: [
      { label: 'Recorded demo', href: 'https://annex.erclx.dev' },
      { label: 'GitHub', href: 'https://github.com/erclx/annex' },
    ],
  },
  {
    name: 'Stackr',
    route: '/stackr',
    description:
      'Staging files by hand for every prompt was the actual bottleneck, so I stopped doing it by hand. VS Code extension that stages files across a workspace into one block of LLM context. Installed from the VS Code Marketplace and Open VSX.',
    poster: stackrPoster,
    videoSrc: stackrVideo,
    mediaAlt: 'Stackr — VS Code panel showing staged files and a context preview',
    mediaPosition: 'left top',
    links: [
      {
        label: 'VS Code Marketplace',
        href: 'https://marketplace.visualstudio.com/items?itemName=erclx.ai-context-stacker',
      },
      {
        label: 'Open VSX',
        href: 'https://open-vsx.org/extension/erclx/ai-context-stacker',
      },
      { label: 'GitHub', href: 'https://github.com/erclx/stackr' },
    ],
  },
  {
    name: 'Caret',
    route: '/caret',
    description:
      'I kept retyping the same prompts across three different chat windows. Chrome extension that saves prompts and drops them into Claude, Gemini, and ChatGPT from the chat input. Live on the Chrome Web Store.',
    poster: caretPoster,
    videoSrc: caretVideo,
    mediaAlt: 'Caret — chat input showing a trigger-character palette of saved prompts',
    links: [
      {
        label: 'Chrome Web Store',
        href: 'https://chromewebstore.google.com/detail/caret/bpmdbibldelkpncegllkeegdpblgehgk',
      },
      { label: 'GitHub', href: 'https://github.com/erclx/caret' },
    ],
  },
]

---

<section id="projects" data-section="projects" class="page-inset py-16 md:py-20">
  <div class="mx-auto max-w-3xl lg:max-w-5xl">
    <h2
      data-fade
      class="font-display text-foreground section-heading leading-tight font-semibold"
    >
      Projects
    </h2>
    {/* The section opened straight onto the grid, which was the only one on the
        page with no line under its heading. A count opened it until 2026-08-14
        and came out because a number small enough to count is one to leave
        unstated, and nothing replaced it.

        The second sentence names the routes rather than sorting the cards by
        what they can prove. Every project owns one, which is what stops a card
        with a live link and a card without reading as a ranking, and the routes
        are otherwise reachable only by clicking a card's name. */}
    <p data-fade class="text-muted-foreground text-body mt-6">
      Some of these solved a problem for me first and other people second. Each
      one has a page here on why it exists and how it works. There is one more
      at <a href="/diction" class="text-foreground underline underline-offset-4">/diction</a>, a pronunciation trainer
      that scores each sound against a native distribution and reports how often
      it is wrong.
    </p>
    {/* The gutter carries the separation the plate used to. It also has to
        clear the halo a hover raises: at a 24px gutter the halo's own box
        reached the neighboring card exactly, and its shadow crossed about
        36px into it, so pointing at one card lit the one beside it. */}
    <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-2">
      {
        projects.map((project, index) => {
          const numeral = String(index + 1).padStart(2, '0')
          const isLeftCol = index % 2 === 0
          const fadeDelay = `${index * 200}ms`
          // An odd count leaves the last card alone in a two-column row, so it
          // closes the section across both columns instead.
          const isWide = projects.length % 2 === 1 && index === projects.length - 1
          return (
            <div
              data-project-frame
              class:list={['relative', isWide && 'lg:col-span-2']}
            >
              <span
                aria-hidden="true"
                data-fade
                style={`--fade-delay: ${fadeDelay}`}
                class:list={[
                  'font-display pointer-events-none absolute z-10 leading-none font-semibold select-none',
                  'top-3 right-5 text-[5rem] text-stone-500/50 dark:text-foreground/12',
                  'lg:top-0 lg:text-[8rem] lg:text-stone-500/65 lg:dark:text-foreground/15',
                  isLeftCol
                    ? 'lg:right-auto lg:-left-12'
                    : 'lg:left-auto lg:-right-12',
                ]}
              >
                {numeral}
              </span>
              <ProjectCard
                name={project.name}
                description={project.description}
                poster={project.poster}
                posterDark={project.posterDark}
                videoSrc={project.videoSrc}
                mediaAlt={project.mediaAlt}
                mediaPosition={project.mediaPosition}
                links={project.links}
                caseStudyHref={project.route}
                index={index}
                isWide={isWide}
              />
            </div>
          )
        })
      }
    </div>
  </div>
</section>

<script>
  import { initHoverVideo } from '@/lib/hover-video'
  import { initReveal } from '@/lib/reveal'

  import { initTilt } from './tilt'

  initReveal()
  initHoverVideo()
  initTilt()
</script>
