---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface PeekImage {
  readonly src: ImageMetadata
  readonly alt: string
}

interface Props {
  readonly images: readonly PeekImage[]
}

const { images } = Astro.props
---

{/* The scroller, the track, and every slide, shared by the inline gallery and
    the preview dialog so the same peek carousel renders at two sizes rather
    than existing as two components that could drift. `data-peek-*` is scoped
    by whichever ancestor mounts it (`[data-screenshot-gallery]` or
    `[data-gallery-preview]`), which is what lets one JS engine drive both
    instances without a second attribute vocabulary. */}
<div class="screenshot-gallery-scroller" data-peek-scroller>
  <div class="screenshot-gallery-track" data-peek-track>
    {/* All five load eager rather than the usual one. Every slide sits in the
        route's first section, so none of them is reached by scrolling the
        page, only the carousel, and the browser's native lazy load keys off
        the page's own viewport. A peeking slide is close enough to that
        viewport to load anyway; the two further off never do, leaving them
        blank for a reader who clicks straight to one. */}
    {
      images.map((image, index) => (
        <button
          type="button"
          class="screenshot-gallery-slide bg-card border-border/60 overflow-hidden rounded-lg border"
          data-peek-slide
          aria-label={`Show screenshot ${index + 1} of ${images.length}`}
        >
          <Image
            src={image.src}
            alt={image.alt}
            class="block h-auto w-full"
            loading="eager"
          />
        </button>
      ))
    }
  </div>
</div>

<style>
  /* Each slide sits at 60% of the scroller's own width, which puts roughly
     30% of a neighbor's own width in view on either side of the centered one
     at every container width either mount gives it. Scroll-snap centers the
     active slide natively, so no transform math tracks it. */
  .screenshot-gallery-scroller {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    /* The slides size against this box rather than against the track's own
       content box, which is what `cqw` below resolves to. See the track's
       padding note for the two ways sizing them against the track failed. */
    container-type: inline-size;
    /* Room for the focus ring, which is drawn outside the slide's border box
       at `outline-2 outline-offset-2` and clipped by this scroller: setting
       `overflow-x: auto` forces the block axis to clip too, so it cannot be
       left visible. The centered slide is the one that suffers, because it
       sits at `scale(1)` and fills the track's height exactly where the
       peeking slides are held clear by their own `scale(0.94)`. */
    padding-block: 0.75rem;
  }
  /* The root's own `scroll-behavior: smooth` governs document scrolling
     alone. A nested scroller takes its own declaration, which is what a
     click-driven `scrollTo` reads. */
  @media (prefers-reduced-motion: no-preference) {
    .screenshot-gallery-scroller {
      scroll-behavior: smooth;
    }
  }
  .screenshot-gallery-scroller::-webkit-scrollbar {
    display: none;
  }
  .screenshot-gallery-track {
    display: flex;
    /* The track wraps its own content rather than taking the scroller's
       width and letting the slides overflow it. Left as a block-level box it
       measures the scroller's 896px while its slides run to about 3000, so
       its trailing padding sits inside that box rather than at the end of
       the content and reserves nothing: the last slide stayed 179px right of
       centre with `scrollLeft` already at `maxScrollLeft`. The tell was that
       `maxScrollLeft` moved between readings, 2051 to 2067, which a fixed
       border box cannot do and a set of scaled children can. */
    width: max-content;
    /* Centering rather than the flex default of stretch, so a slide keeps
       its own aspect ratio instead of being pulled to the tallest one's
       height and showing the card ground under its image. The five captures
       are one size today, which makes this inert on them and is why it is
       worth keeping: it was written when two of them ran taller, and a sixth
       taken at another viewport would bring that back. */
    align-items: center;
    gap: 1.5rem;
    /* Room for the first and last slides to reach a centered scroll
       position. Real padding on the track rather than pseudo-element flex
       items, which is the second thing tried here and the first that holds
       at both ends.
       Padding was rejected once because a child's percentage `flex-basis`
       resolves against the track's content box, so padding shrank every
       slide along with it: measured at 333px against the 538px `60%` was
       meant to produce. The slides take `cqw` below now, resolving against
       the scroller instead, so the padding no longer reaches them.
       The spacers that replaced it then failed at the far end alone.
       `align-items: center` collapsed them to `height: 0`, and a
       zero-height box contributes no scrollable overflow, so the trailing
       one reserved no scroll distance: measured 2075px of `maxScrollLeft`
       against the 2271px centering the last slide needs, leaving it 195px
       right of centre with no scroll left to correct it. Padding is part of
       the track's own border box, so it reserves that distance whatever the
       children's height or transform does. */
    padding-inline: 20%;
    padding-inline: 20cqw;
  }
  .screenshot-gallery-slide {
    /* The percentage is the fallback where `cqw` does not resolve, and it
       reads the padded content box, so it runs narrow rather than absent. */
    flex: 0 0 60%;
    flex-basis: 60cqw;
    scroll-snap-align: center;
    padding: 0;
    cursor: pointer;
    opacity: 0.55;
    transform: scale(0.94);
  }
  .screenshot-gallery-slide[data-active] {
    opacity: 1;
    transform: scale(1);
    /* A click here has nowhere left to advance to, so the inline gallery
       reads it as opening the preview, and the preview reads it as nothing.
       The cursor still promises the inline behavior, since that is the mount
       a reader meets it at first. */
    cursor: zoom-in;
  }
  @media (prefers-reduced-motion: no-preference) {
    .screenshot-gallery-slide {
      transition:
        opacity 320ms ease,
        transform 320ms ease;
    }
  }
</style>
