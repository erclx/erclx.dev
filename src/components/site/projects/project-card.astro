---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

import { getLinkTargetAttributes } from '@/lib/links'

interface ProjectLink {
  label: string
  href: string
}

interface Props {
  name: string
  description: string
  poster?: ImageMetadata
  videoSrc?: string
  mediaAlt?: string
  mediaPosition?: string
  links: ProjectLink[]
  caseStudyHref?: string
  index?: number
  isWide?: boolean
}

const {
  name,
  description,
  poster,
  videoSrc,
  mediaAlt,
  mediaPosition = 'top',
  links,
  caseStudyHref,
  index = 0,
  isWide = false,
} = Astro.props

const fadeDelay = `${index * 200}ms`
// The origin graph fans into these cards and links each leaf to one by name.
const cardId = name.toLowerCase()
---

<article
  id={cardId}
  data-fade
  data-tilt
  style={`--fade-delay: ${fadeDelay}`}
  class:list={[
    'scroll-mt-24 border-border hover:border-foreground/30 bg-card group/card relative flex h-full flex-col overflow-hidden rounded-lg border transition-colors duration-200 [transform:perspective(900px)_rotateX(var(--tilt-x,0deg))_rotateY(var(--tilt-y,0deg))] [transform-style:preserve-3d] [will-change:transform]',
    isWide && 'lg:flex-row lg:items-stretch',
  ]}
>
  {
    poster && mediaAlt && (
      <div
        data-media-slot
        class:list={[
          'bg-muted/40 relative aspect-[11/7] overflow-hidden border-b border-border/60 p-2 sm:p-3',
          isWide && 'lg:aspect-auto lg:w-1/2 lg:min-h-72 lg:border-r lg:border-b-0',
        ]}
      >
        <div class="ring-border/40 relative size-full overflow-hidden rounded-md shadow-sm ring-1 [transform:translate3d(var(--parallax-x,0),var(--parallax-y,0),0)] [will-change:transform]">
          <Image
            src={poster}
            alt={mediaAlt}
            style={`object-position: ${mediaPosition}`}
            class="absolute inset-0 size-full object-cover"
            data-media-poster
          />
          {videoSrc && (
            <video
              src={videoSrc}
              poster={poster.src}
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
              style={`object-position: ${mediaPosition}`}
              class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-200 group-hover/card:opacity-100"
              data-media-video
            />
          )}
        </div>
      </div>
    )
  }
  <div class:list={['p-6 md:p-10', isWide && 'lg:flex-1 lg:self-center']}>
    <h3 class="font-display text-heading text-foreground">
      {name}
    </h3>
    <p class="text-muted-foreground text-body mt-4">
      {description}
    </p>
    <ul class="mt-6 flex flex-wrap gap-x-6">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              {...getLinkTargetAttributes(link.href)}
              class="text-foreground text-label relative z-10 inline-flex min-h-11 min-w-11 items-center underline-offset-4 hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  {
    caseStudyHref && (
      <a
        href={caseStudyHref}
        aria-hidden="true"
        tabindex="-1"
        class="absolute inset-0"
      />
    )
  }
</article>
