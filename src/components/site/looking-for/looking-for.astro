---
// The upstream source lists these lowercase and states that the site owns how
// a string renders, so the casing is decided here. Sentence case leaves the
// uppercase treatment to the eyebrow and the diagram labels, which is the one
// job it can hold consistently.
const criteria = [
  {
    label: 'What I want to build',
    value: 'AI tooling · LLM apps · devex',
  },
  {
    label: 'Team',
    value: 'small to mid · close to the product',
  },
  {
    label: 'Where',
    value: 'Sweden, Gothenburg preferred · remote',
  },
  {
    label: 'Experience',
    value: 'two years in',
  },
  {
    label: 'Terms',
    value: 'full-time or contract',
  },
]
---

{/* Opens on the page's own interval and closes tighter than it. Every heading
    boundary on all six pages holds 160px, which this section arrived 28px
    short of while carrying `pt-10` where every other section carries the
    step. That was drift rather than a decision, and `e2e/rhythm.ts` is what
    found it.

    It reads 172px even so, and the remaining 12 belong to the projects grid
    rather than to this section: a card's last paragraph sits 12px above where
    that section's content box ends, where every other section closes flush.
    Trimming this step to 68px would read 160 and would be a literal here
    standing in for a value over there, which is the shape
    `.claude/ARCHITECTURE.md` bans by name. The step matches every sibling
    instead and one boundary reads seven percent wide.

    The close is the deliberate half. A boundary arriving on a heading has
    something that stops the eye and says new content, and this one arrives on
    the signature, which is decoration and hidden from assistive technology, so
    the same interval read as emptiness. It holds 124px against the 172 it
    carried before, both read from the last text in this section down to the
    top of the signature, which is the first thing the footer paints. The 48px
    between them is this section's own step, `pb-20` against `pb-8`. */}
<section
  id="looking-for"
  data-section="looking-for"
  class="page-inset pt-16 pb-8 md:pt-20"
>
  <div class="mx-auto max-w-3xl">
    <h2
      data-fade
      class="font-display text-foreground section-heading leading-tight font-semibold"
    >
      Looking for
    </h2>

    {/* The availability status anchors this section rather than joining the
        rows below it. It sits at body size in the foreground color because a
        sixth label would add a line to a section that needs weight. */}
    <p
      data-fade
      style="--fade-delay: 75ms"
      class="text-foreground text-body mt-4 inline-flex items-baseline gap-3"
    >
      <span class="status-dot-slot" aria-hidden="true">
        <span class="status-dot"></span>
      </span>
      Open to work
    </p>

    <div class="looking-stage relative mt-7">
      {/* A window sitting directly on the rule, clipping whatever hangs below
          it. The rows carried an opaque plate for this instead, which is the
          one surface on the page that hid the ground behind it: every other
          section let the field through and this one read as a solid block.
          Clipping the thing that needs hiding costs the section nothing. */}
      <div
        class="looking-peek-window absolute right-0 bottom-full z-0 aspect-[120/130] w-24 overflow-hidden sm:right-8 md:right-14 md:w-28"
        aria-hidden="true"
      >
      <div
        class="looking-peek"
      >
        <svg viewBox="0 0 120 130" class="block size-full">
          <path d="M 14 32 L 30 4 L 42 32 Z" fill="#d4a574" />
          <path d="M 106 32 L 90 4 L 78 32 Z" fill="#d4a574" />
          <path d="M 24 28 L 30 14 L 36 28 Z" fill="#faecd3" />
          <path d="M 96 28 L 90 14 L 84 28 Z" fill="#faecd3" />
          <path
            d="M 22 50 Q 22 24 60 24 Q 98 24 98 50 Q 98 80 60 96 Q 22 80 22 50 Z"
            fill="#d4a574"
          />
          <path
            d="M 30 94 Q 30 116 60 120 Q 90 116 90 94 L 90 130 L 30 130 Z"
            fill="#d4a574"
          />
          <path
            d="M 36 62 Q 36 56 60 54 Q 84 56 84 62 Q 84 82 60 96 Q 36 82 36 62 Z"
            fill="#faecd3"
          />
          <ellipse cx="42" cy="48" rx="3.5" ry="2" fill="#faecd3" />
          <ellipse cx="78" cy="48" rx="3.5" ry="2" fill="#faecd3" />
          <ellipse cx="42" cy="58" rx="2.6" ry="3" fill="#2a1d14" />
          <ellipse cx="78" cy="58" rx="2.6" ry="3" fill="#2a1d14" />
          <ellipse cx="60" cy="72" rx="3.6" ry="2.6" fill="#2a1d14" />
          <path
            d="M 60 74 L 60 80"
            stroke="#2a1d14"
            stroke-width="1.5"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M 60 80 Q 56 84 51 82"
            stroke="#2a1d14"
            stroke-width="1.5"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M 60 80 Q 64 84 69 82"
            stroke="#2a1d14"
            stroke-width="1.5"
            stroke-linecap="round"
            fill="none"
          />
          <ellipse cx="36" cy="92" rx="9" ry="6.5" fill="#d4a574" />
          <path
            d="M 31 88 L 31 94"
            stroke="#a07a52"
            stroke-width="1.2"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M 36 87 L 36 94"
            stroke="#a07a52"
            stroke-width="1.2"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M 41 88 L 41 94"
            stroke="#a07a52"
            stroke-width="1.2"
            stroke-linecap="round"
            fill="none"
          />
          <ellipse cx="84" cy="92" rx="9" ry="6.5" fill="#d4a574" />
          <path
            d="M 79 88 L 79 94"
            stroke="#a07a52"
            stroke-width="1.2"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M 84 87 L 84 94"
            stroke="#a07a52"
            stroke-width="1.2"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M 89 88 L 89 94"
            stroke="#a07a52"
            stroke-width="1.2"
            stroke-linecap="round"
            fill="none"
          />
        </svg>
      </div>
      </div>

      <div
        class="looking-rows border-border/60 relative z-10 border-t pt-6"
      >
        {/* A gap per row rather than a rule between them. The rules made this
            the last surface on the page reading as a table, on a page whose
            hero seam, bar, cards and footer all stopped drawing lines. Space
            separates the rows now and the pairing still scans, which is the
            only job this list has.

            The rule above the rows stays, and it is not an exception left by
            accident. The character peeks over that edge, so it is the ledge a
            drawing sits on rather than table chrome, and removing it leaves
            the character with nothing to hide behind.

            Each row keeps its vertical padding. The left border that lights on
            hover is an affordance rather than a division, and it needs a row
            tall enough to draw against. */}
        {/* Grouped like the timeline, so the criteria read down rather than
            landing together. Seven rows arriving in one observer callback got
            57ms apart against a 700ms fade, and one per callback got nothing
            at all. See `src/lib/reveal.ts`. */}
        <dl data-fade-group class="grid gap-y-2">
          {
            criteria.map((item, idx) => (
              <div
                data-fade
                style={`--fade-delay: ${150 + idx * 100}ms`}
                class="looking-row group -ml-4 grid items-baseline gap-x-6 border-l-2 border-l-transparent py-3 pl-4 sm:grid-cols-[13rem_1fr]"
              >
                {/* The key steps back rather than the answer stepping forward.
                    The answers used to render at foreground, which measured
                    3.35x the contrast of every paragraph on the page in light
                    and made the closing section the heaviest reading on it.

                    Dropping them alone was tried and does not work: color is
                    the only thing separating the two columns, so with both at
                    prose weight the rows stop scanning as pairs. A third step
                    on the key is what buys the answer its way down. */}
                <dt class="looking-key text-label">{item.label}</dt>
                {/* The answer sits at the weight the page reads at, and lifts
                    to foreground under a pointer. */}
                <dd class="text-muted-foreground group-hover:text-foreground text-label">
                  {item.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  /* The key separates from the answer by weight rather than by lightness.
     Lightness has no room here: the muted token is already 4.82:1 in light,
     so a step below it fails the 4.5:1 floor for text at any value visible
     enough to do the job. A 65% mix was shipped and measured 2.53:1.

     Both columns therefore sit on the muted token and the key drops a weight
     step, which the 13rem column between them does most of the work of. */
  .looking-key {
    color: var(--muted-foreground);
    font-weight: 400;
  }

  /* A row is a box a pointer lands on, so it takes the glow every other
     bounded control carries. It is drawn behind the pair and inset outward,
     the way the project card's is, so the rows stay ruleless at rest. */
  .looking-row {
    position: relative;
    isolation: isolate;
  }
  .looking-row::after {
    content: '';
    position: absolute;
    inset: -0.25rem -1rem;
    border-radius: 0.75rem;
    z-index: -1;
    opacity: 0;
    background: var(--glow-fill);
    box-shadow: var(--glow-shadow);
  }
  .looking-row:hover::after {
    opacity: 1;
  }

  /* The accent edge is drawn here rather than as the row's own left border.
     A negative z-index child paints above its parent's background and border
     and below its content, so the glow above reached the border box and laid
     its 60% white over the edge: the accent should paint near rgb(165,70,28)
     and measured rgb(219,181,164) once the glow arrived. The edge appeared at
     full strength on the first frame and washed out as the glow faded in.

     The transparent border stays on the row, because it is what holds the
     2px the layout is built around. This only takes over what it draws. */
  /* Offset by its own width, because an absolutely positioned child resolves
     against the padding box and the border it replaces sits outside that. At
     `left: 0` the edge drew 2px inboard of where it had always been. */
  .looking-row::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 -2px;
    width: 2px;
    z-index: 0;
    background: transparent;
  }
  .looking-row:hover::before {
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .looking-key {
      transition: color 150ms ease-out;
    }
    .looking-row::after {
      transition: opacity var(--glow-out) ease-out;
    }
    .looking-row:hover::after {
      transition: opacity var(--glow-in) ease-out;
    }
  }

  /* The slot rests on the label's baseline and stands one cap height tall, so
     the dot inside it centres on the capitals rather than on the line box. The
     descender space under the baseline is empty and still counts toward a line
     box's middle. */
  .status-dot-slot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1cap;
  }
  /* The dot takes the size and the ring the experience section's active marker
     carries, so the two read as one shape language. The color stays its own:
     green states availability where the accent states position. */
  .status-dot {
    position: relative;
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 9999px;
    background-color: var(--chart-2);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--chart-2) 18%, transparent);
  }
  /* The halo is a pseudo-element so the pulse never changes the dot's own box
     and nothing on the status line reflows on it. */
  @media (prefers-reduced-motion: no-preference) {
    .status-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background-color: var(--chart-2);
      animation: status-ping 2400ms cubic-bezier(0.2, 0, 0.4, 1) infinite;
    }
    @keyframes status-ping {
      from {
        opacity: 0.5;
        transform: scale(1);
      }
      70% {
        opacity: 0;
        transform: scale(2.6);
      }
      to {
        opacity: 0;
        transform: scale(2.6);
      }
    }
  }
  /* Measured from the window's own bottom edge, which sits on the rule. Fully
     down is fully clipped, and the visible state shows the top of him with the
     rest cut by the window rather than covered by a plate. */
  .looking-peek {
    transform: translateY(100%);
    transition: transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .looking-stage[data-peek-visible='true'] .looking-peek {
    transform: translateY(27%);
  }
  .looking-stage[data-peek-visible='true'][data-peek-ducked='true']
    .looking-peek {
    transform: translateY(100%);
    transition: transform 350ms ease-in;
  }
  @media (prefers-reduced-motion: reduce) {
    .looking-peek {
      transform: translateY(27%);
      transition: none;
    }
  }
</style>

<script>
  import { hasHoverPointer } from '@/lib/pointer'

  const stage = document.querySelector<HTMLElement>('.looking-stage')
  const rows = stage?.querySelector<HTMLElement>('.looking-rows')
  if (stage && rows) {
    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              stage.dataset.peekVisible = 'true'
              observer.unobserve(entry.target)
            }
          }
        },
        { threshold: 0.4 },
      )
      observer.observe(stage)
    } else {
      stage.dataset.peekVisible = 'true'
    }

    // The peek ducks for a pointer resting over the rows and returns when it
    // leaves. A touch pointer is destroyed on lift, so a finger crossing the
    // rows on its way down the page ducked the peek and nothing brought it
    // back.
    if (!reduce && hasHoverPointer()) {
      rows.addEventListener('pointerenter', () => {
        stage.dataset.peekDucked = 'true'
      })
      rows.addEventListener('pointerleave', () => {
        delete stage.dataset.peekDucked
      })
    }
  }
</script>
