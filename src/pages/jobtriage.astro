---
import { getImage } from 'astro:assets'

import BaseLayout from '@/layouts/base.astro'
import RouteBar from '@/components/site/nav/route-bar.astro'
import SectionNav from '@/components/site/section-nav/section-nav.astro'
import RouteFoot from '@/components/site/case-study/route-foot.astro'
import { getLinkTargetAttributes } from '@/lib/links'
import triageCanvas from '@/assets/projects/jobtriage.png'
import canvasViews from '@/assets/videos/jobtriage.mp4?url'

const artifactLinks = [
  { label: 'Live demo', href: 'https://jobtriage.erclx.dev' },
  { label: 'GitHub', href: 'https://github.com/erclx/jobtriage' },
]

// A `poster` attribute takes a URL rather than an image, so it reaches for the
// source file unless something derives the optimized one. The raw png is 333KB
// against 43KB for the webp, on the first image the route paints.
const triagePoster = await getImage({ src: triageCanvas, format: 'webp' })

// The route's opening leads the rail. Without it the rail names no row for the
// first 700 to 900px of every route, since it is shown from first paint here
// and the first prose section starts that far down, so a position indicator
// states no position for the whole opening screen. The label is the heading it
// points at, which is the rule every other row already follows.
const navItems = [
  { id: 'jobtriage', label: 'jobtriage' },
  { id: 'problem', label: 'problem' },
  { id: 'system', label: 'system' },
  { id: 'retrieval', label: 'retrieval' },
  { id: 'agent', label: 'agent' },
]

const stack = [
  { key: 'Frontend', value: 'Next.js App Router on Vercel, Vercel AI SDK' },
  { key: 'Backend', value: 'FastAPI on Cloud Run europe-west1, 1Gi memory' },
  {
    key: 'Retrieval',
    value: 'BM25 + multilingual-e5-base dense + RRF over SQLite',
  },
  {
    key: 'BYOK',
    value: 'Anthropic, OpenAI, Gemini, local Ollama, mock replay',
  },
  { key: 'Domain', value: 'Cloudflare A record fronting Vercel' },
]

const ablation = [
  { config: 'filter-only', p1: '0.020', r10: '0.150', p95: '0.0' },
  { config: 'bm25-only', p1: '0.680', r10: '0.920', p95: '1.2' },
  { config: 'dense-only', p1: '0.780', r10: '0.965', p95: '7.8' },
  { config: 'hybrid', p1: '0.720', r10: '0.950', p95: '15.2' },
]

const encoders = [
  { encoder: 'MiniLM (en)', p1: '0.700', r10: '0.855', dim: '384' },
  { encoder: 'e5-base (ml)', p1: '0.780', r10: '0.965', dim: '768' },
  { encoder: 'e5-large (ml)', p1: '0.860', r10: '0.945', dim: '1024' },
]

const toolPairings = [
  { data: 'searchJobs', spatial: 'placeAds' },
  { data: 'triageBatch', spatial: 'groupAds' },
  { data: 'matchProfile', spatial: 'connectProfileToAds' },
  { data: 'compareRoles', spatial: 'pairAdsForCompare' },
  { data: 'deadlineWatch', spatial: 'placeAdsOnTimeline' },
  { data: 'trackStatus', spatial: 'markStatus' },
]

---

<BaseLayout
  title="Jobtriage · Eric Le"
  description="Two postures share one agent shell. Hybrid retrieval, multilingual encoders, and pinned spatial tools behind the Jobtriage demo."
  surface="case-study"
>
  <SectionNav items={navItems} instant />

  <RouteBar here="Jobtriage" />

  <main>
    <section id="jobtriage" class="page-inset pt-16 pb-12 md:pt-20 md:pb-16">
      <div class="mx-auto prose-column">
        <p data-fade class="text-muted-foreground text-label tracking-wide uppercase">
          Project
        </p>
        <h1
          data-fade          class="font-display text-foreground mt-4 text-[2.25rem] leading-tight font-semibold md:text-[2.75rem]"
        >
          Jobtriage
        </h1>
        <p
          data-fade          class="text-muted-foreground text-lede mt-4"
        >
          A live agent that triages Swedish job ads against any profile.
        </p>
        <ul
          data-fade          class="mt-6 flex flex-wrap gap-x-6"
        >
          {
            artifactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...getLinkTargetAttributes(link.href)}
                  class="text-foreground text-label inline-flex min-h-11 min-w-11 items-center underline-offset-4 hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        {/* The canvas closes the opening rather than interrupting it, so a
            reader sees what triage looks like before the prose argues it. The
            still is this clip's own opening frame, so it serves as the poster
            rather than as a second figure of the same scene. It declares
            `view` so a phone, which cannot hover, plays it on screen. */}
        <figure
          data-media-host="view"
          data-fade          class="figure-breakout bg-card border-border/60 mt-12 overflow-hidden rounded-lg border"
        >
          <video
            src={canvasViews}
            poster={triagePoster.src}
            muted
            loop
            playsinline
            preload="none"
            data-media-video
            aria-label="The Jobtriage canvas grouping Stockholm nursing ads into strong-fit and consider clusters, each ad carrying a match score and a one-line rationale"
            class="block h-auto w-full"></video>
        </figure>
      </div>
    </section>

    <section id="problem" class="page-inset py-16 md:py-20">
      <div class="mx-auto prose-column">
        <h2 data-fade class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl">
          problem
        </h2>
        <p
          data-fade          class="text-foreground text-lede mt-6"
        >
          I wanted a project where a language model drove the interface rather
          than sitting behind it. Handing it the canvas, the filters, and the
          layout is a different problem from returning a good answer.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          Job boards rank for what the platform earns from rather than for
          what fits the candidate. Profile-driven match is a first-class
          operation here rather than a filter bolted onto a search box.
        </p>
      </div>
    </section>

    <section id="system" class="page-inset py-16 md:py-20">
      <div class="mx-auto prose-column">
        <h2 data-fade class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl">
          system
        </h2>
        <p
          data-fade          class="text-foreground text-lede mt-6"
        >
          Two postures share one agent shell: same prompt, same tools,
          different data path.
        </p>

        <figure
          data-fade          class="figure-breakout bg-card mt-10 rounded-lg p-6 md:p-10"
        >
          <div class="font-mono text-label flex flex-col items-center gap-6">
            <div
              class="border-border text-foreground rounded-md border px-4 py-2"
            >
              agent shell
            </div>
            <div
              aria-hidden="true"
              class="bg-border h-6 w-px"
            >
            </div>
            <div
              aria-hidden="true"
              class="bg-border h-px w-3/4"
            >
            </div>
            <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
              <div class="flex flex-col items-center gap-3">
                <div
                  aria-hidden="true"
                  class="bg-border -mt-8 h-6 w-px"
                >
                </div>
                <div
                  class="text-muted-foreground tracking-wide uppercase"
                >
                  deploy
                </div>
                <div
                  class="border-border text-foreground rounded-md border px-4 py-3 text-center"
                >
                  JobTech taxonomy and JobSearch APIs
                </div>
              </div>
              <div class="flex flex-col items-center gap-3">
                <div
                  aria-hidden="true"
                  class="bg-border -mt-8 h-6 w-px"
                >
                </div>
                <div
                  class="text-muted-foreground tracking-wide uppercase"
                >
                  local
                </div>
                <div
                  class="border-border text-foreground rounded-md border px-4 py-3 text-center"
                >
                  SQLite corpus, hybrid retrieval stack
                </div>
              </div>
            </div>
          </div>
        </figure>

        <p
          data-fade          class="text-muted-foreground text-body mt-8"
        >
          The deployed posture runs against the JobTech taxonomy and
          JobSearch APIs. The local CLI and local dev run the hybrid
          retrieval stack against a SQLite corpus.
        </p>

        <dl
          data-fade          class="mt-10 grid gap-y-2 sm:grid-cols-[8rem_1fr]"
        >
          {
            stack.map((row) => (
              <div class="contents font-mono text-label">
                <dt class="text-muted-foreground">{row.key}</dt>
                <dd class="text-foreground">{row.value}</dd>
              </div>
            ))
          }
        </dl>

        <p
          data-fade          class="text-muted-foreground text-body mt-8"
        >
          Two entry paths carry the surface. Mock replay lets a recruiter
          drive the agent in five seconds with no key. BYOK lets a technical
          visitor drive it with their own. Most agent demos offer neither.
        </p>
      </div>
    </section>

    <section id="retrieval" class="page-inset py-16 md:py-20">
      <div class="mx-auto prose-column">
        <h2 data-fade class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl">
          retrieval
        </h2>
        <p
          data-fade          class="text-foreground text-lede mt-6"
        >
          Both paths depend on the same thing underneath: finding the right
          ad. That was measured rather than assumed.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          Measured on a 50-query Swedish golden set against a 59-ad corpus
          drawn from Spotify,
          Klarna, Volvo Group, Volvo Cars, Ericsson, HT Engineering, Stig
          Ericsson Bil, Montico, and Isaksson Rekrytering. Embeddings from
          <a
            href="https://huggingface.co/intfloat/multilingual-e5-base"
            {...getLinkTargetAttributes(
              'https://huggingface.co/intfloat/multilingual-e5-base',
            )}
            class="text-accent underline underline-offset-[3px] decoration-[1px] font-mono"
          >intfloat/multilingual-e5-base</a>.
        </p>

        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          Three numbers repeat through this section: P@1 asks whether the
          top result is right, R@10 asks whether the right one is somewhere
          in the top ten, and p95 ms is the 95th-percentile query latency.
        </p>

        <figure
          data-fade          class="figure-breakout bg-card mt-10 overflow-x-auto rounded-lg p-6 md:p-10"
        >
          <figcaption
            class="text-muted-foreground font-mono text-label mb-4"
          >
            hybrid retrieval ablation
          </figcaption>
          <table class="font-mono text-label w-full min-w-[20rem]">
            <thead>
              <tr class="text-muted-foreground">
                <th class="text-left font-normal">configuration</th>
                <th class="text-right font-normal tabular-nums">P@1</th>
                <th class="text-right font-normal tabular-nums">R@10</th>
                <th class="text-right font-normal tabular-nums">p95 ms</th>
              </tr>
            </thead>
            <tbody class="text-foreground">
              {
                ablation.map((row) => (
                  <tr>
                    <td class="py-1 pr-4">{row.config}</td>
                    <td class="py-1 pl-4 text-right tabular-nums">{row.p1}</td>
                    <td class="py-1 pl-4 text-right tabular-nums">{row.r10}</td>
                    <td class="py-1 pl-4 text-right tabular-nums">
                      {row.p95}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </figure>

        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          Dense alone takes P@1 by 6 points over hybrid on this corpus.
          Hybrid earns its place on adversarial queries where an exact
          keyword carries the match, such as a model name or employer
          jargon. An RRF score floor at
          <code class="font-mono">JOBTRIAGE_RRF_FLOOR=0.025</code>
          suppresses low-relevance noise at the API boundary.
        </p>

        <figure
          data-fade          class="figure-breakout bg-card mt-10 overflow-x-auto rounded-lg p-6 md:p-10"
        >
          <figcaption
            class="text-muted-foreground font-mono text-label mb-4"
          >
            multilingual encoder comparison (dense)
          </figcaption>
          <table class="font-mono text-label w-full min-w-[20rem]">
            <thead>
              <tr class="text-muted-foreground">
                <th class="text-left font-normal">encoder</th>
                <th class="text-right font-normal tabular-nums">P@1</th>
                <th class="text-right font-normal tabular-nums">R@10</th>
                <th class="text-right font-normal tabular-nums">dim</th>
              </tr>
            </thead>
            <tbody class="text-foreground">
              {
                encoders.map((row) => (
                  <tr>
                    <td class="py-1 pr-4">{row.encoder}</td>
                    <td class="py-1 pl-4 text-right tabular-nums">{row.p1}</td>
                    <td class="py-1 pl-4 text-right tabular-nums">{row.r10}</td>
                    <td class="py-1 pl-4 text-right tabular-nums">{row.dim}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </figure>

        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          English-only MiniLM gives up 11 points of recall@10 against
          e5-base on the Swedish set. e5-large lifts P@1 by another 8 points
          over e5-base and hands back two points of recall@10, so e5-base
          ships as the balanced default. The MiniLM dense numbers run
          slightly suppressed because the e5 prefix tokens it never trained
          on read as noise. The encoder choice carries the result rather
          than decorating it.
        </p>
      </div>
    </section>

    <section id="agent" class="page-inset py-16 md:py-20">
      <div class="mx-auto prose-column">
        <h2 data-fade class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl">
          agent
        </h2>
        <p
          data-fade          class="text-foreground text-lede mt-6"
        >
          Retrieval finds the right ad. What the agent does with it once
          found is a separate problem.
        </p>
        <p
          data-fade          class="text-muted-foreground text-body mt-6"
        >
          Spatial tool pairings are pinned in the system prompt, so the
          agent fires a spatial tool after every data tool and the canvas
          answers the question rather than illustrating it.
        </p>

        <dl
          data-fade          class="mt-10 grid gap-y-2 sm:grid-cols-[1fr_auto_1fr]"
        >
          {
            toolPairings.map((pair) => (
              <div class="contents font-mono text-label">
                <dt class="text-foreground">{pair.data}</dt>
                <span
                  aria-hidden="true"
                  class="text-muted-foreground hidden sm:inline-block sm:px-4"
                >
                  →
                </span>
                <dd class="text-foreground">{pair.spatial}</dd>
              </div>
            ))
          }
        </dl>

        <p
          data-fade          class="text-muted-foreground text-body mt-8"
        >
          React Flow surfaces four canonical views: triage clusters, deadline
          timeline, side-by-side compare, and pinned shortlist. Each view
          carries custom nodes rather than the React Flow defaults.
        </p>

      </div>
    </section>

  </main>

  <RouteFoot />

  <script>
    import { initWayHome } from '@/components/site/case-study/way-home'
    import { initHoverVideo } from '@/lib/hover-video'
    import { initReveal } from '@/lib/reveal'

    initReveal()
    initWayHome()
    initHoverVideo()
  </script>
</BaseLayout>
