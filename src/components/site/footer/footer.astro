---
import signatureSvg from '@/assets/footer/signature.svg?raw'
import { github, linkedin } from '@/lib/contact'

// Taken at build time, so it states the last deploy rather than the current
// date and stays true without anything maintaining it. A month rather than a
// year alone, because within the current year a bare year carries almost no
// information, which is the ambiguity this line replaced.
const updated = new Date().toLocaleDateString('en-GB', {
  month: 'long',
  year: 'numeric',
})

// Where else to find the author, which a reader at the end of the page goes
// looking for. The résumé left for the closing ask, where a reader decides to
// act.
const profiles = [github, linkedin]
---

<footer data-section="footer" class="page-inset pb-10 md:pb-16">
  {
    /* No rule across the top. The closing ask above ends on five row
      separators, and a sixth line under them read as a stack rather than as a
      division.

      What marks the footer instead is the space before it and the signature
      opening it, which is what a reader was using anyway.

      It holds the column every section holds rather than breaking out to
      64rem, which started it 128px left of the sections at 1440, on an edge
      nothing above it used. */
  }
  <div class="mx-auto max-w-3xl pt-16 md:pt-20">
    <div
      data-signature
      aria-hidden="true"
      class="text-foreground aspect-[716/255] w-[clamp(7rem,_14vw_+_3rem,_16rem)] max-w-full [&>svg]:block [&>svg]:size-full"
      set:html={signatureSvg}
    />
    {
      /* The footer arrived with nothing: it carried no reveal marker at all
        while every section above it animated, so a reader scrolling to the end
        met the last surface already in place. The signature is the exception
        and keeps its own wipe.

        Grouped rather than left to the batch path, because these two stack at
        narrow widths and would then cross the viewport edge separately, which
        gives a batch of one and a step of zero.

        Centred rather than aligned on the bottom edge or the baseline. The
        links carry 44px boxes with their 20px line centred, and the date is
        one 20px line, so centring puts both lines in one place. Bottoms set
        the links 12px above the date, and the baseline put them 3px above it,
        since a row opening on an icon takes its baseline from the icon's
        bottom edge rather than from the text. */
    }
    <div
      data-fade-group
      class="mt-8 flex flex-col gap-3 md:mt-10 md:flex-row md:items-center md:justify-between md:gap-12"
    >
      <nav aria-label="Elsewhere" data-fade class="flex gap-5">
        {
          profiles.map((link) => (
            <a
              href={link.href}
              {...link.attributes}
              class="text-muted-foreground hover:text-foreground text-label inline-flex min-h-11 items-center gap-2 underline-offset-4 hover:underline"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4"
                aria-hidden="true"
              >
                {link.paths.map((path) => (
                  <path d={path} />
                ))}
              </svg>
              {link.label}
            </a>
          ))
        }
      </nav>
      {
        /* The city left this line rather than moving. The closing ask already
          states it as a filter, which is where the scope doc put it, so the
          footer was repeating it beside a year that read as a copyright with
          its symbol missing. */
      }
      <div data-fade class="text-muted-foreground text-label md:text-right">
        <p data-updated>Updated {updated}</p>
      </div>
    </div>
  </div>
</footer>

<script>
  import { initFooterSignature } from './footer-signature'

  initFooterSignature()
</script>
