---
interface HistoryEntry {
  current?: boolean
  span: string
  head: string
  detail: string
}

const history: HistoryEntry[] = [
  {
    current: true,
    span: '2026',
    head: 'shipping independently, open to the next thing',
    detail: 'Every project below started as something that was slowing me down.',
  },
  {
    span: '2025',
    head: 'upskilling, and working out what to build',
    detail:
      'Going deeper on the tooling side before building anything worth showing.',
  },
  {
    span: '2024 to 2025',
    head: 'eighteen months at volvo technology',
    detail:
      'It started as a master’s thesis, an agent that turned plain questions into sandboxed Python over truck telematics data. I rebuilt it as a multi-step SQL pipeline with session memory that engineers tested against their own data.',
  },
  {
    span: '2022 to 2024',
    head: 'msc in complex adaptive systems, chalmers',
    detail:
      'How simple agents and their environment produce behavior nobody designed.',
  },
  {
    span: '2019 to 2022',
    head: 'bsc in engineering physics, chalmers',
    detail:
      'Taught me to break a problem down before reaching for a tool, which is most of the job now.',
  },
]

// The chips name the cards in the projects section below, in their rendered
// order, since those artifacts are what the newest beat produced. An e2e test
// compares the two lists so a card added there cannot drift from this one.
const artifacts = [
  { label: 'aitk', href: '#aitk' },
  { label: 'Jobtriage', href: '#jobtriage' },
  { label: 'Stackr', href: '#stackr' },
  { label: 'Caret', href: '#caret' },
  { label: 'diction', href: '#diction' },
]
---

<section id="origin" data-section="origin" class="px-6 py-16 md:py-20">
  <div class="mx-auto max-w-3xl">
    <h2
      data-fade
      class="font-display text-foreground text-[1.75rem] leading-tight font-semibold sm:text-[2.25rem] md:text-[2.75rem]"
    >
      Origin
    </h2>
    <div class="origin-stage mt-10 lg:mt-14">
      <ol class="origin-list flex flex-col font-mono">
        {
          history.map((entry, idx) => (
            <li
              data-fade
              data-default-active={entry.current ? 'true' : undefined}
              aria-current={entry.current ? 'step' : undefined}
              style={`--fade-delay: ${150 + idx * 100}ms`}
              class="origin-row text-body grid grid-cols-[3.25rem_1fr] items-start"
            >
              <span class="origin-gutter" aria-hidden="true">
                <span class="origin-marker-line">
                  <span class="origin-marker"></span>
                </span>
              </span>
              <div>
                <p>
                  <span class="tabular-nums">{entry.span}</span>
                  <span class="px-1" aria-hidden="true">
                    ·
                  </span>
                  {entry.head}
                </p>
                <p class="origin-detail text-label mt-2 font-sans">
                  {entry.detail}
                </p>
                {entry.current && (
                  <ul class="mt-3 flex flex-wrap gap-x-2">
                    {artifacts.map((artifact) => (
                      <li>
                        <a href={artifact.href} class="origin-chip-hit">
                          <span class="origin-chip text-label">
                            {artifact.label}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <p
      data-fade
      style="--fade-delay: 750ms"
      class="font-display text-label text-muted-foreground mt-10 max-w-xl italic"
    >
      Each entry made the next one possible.
    </p>
  </div>
</section>

<style>
  .origin-list {
    --origin-beat-gap: 1.75rem;
  }
  .origin-row {
    color: var(--muted-foreground);
    padding-bottom: var(--origin-beat-gap);
  }
  .origin-row:last-child {
    padding-bottom: 0;
  }
  /* Two derived positions carry the rail. The dot centres inside a box one line
     tall, so it lands on the row's first line whatever the type scale does, and
     each segment runs from that centre to the next row's, reaching it by the
     one gap value the rows are spaced with. No offset is measured or written. */
  .origin-gutter {
    position: relative;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .origin-marker-line {
    display: flex;
    align-items: center;
    height: 1lh;
  }
  .origin-row:not(:last-child) .origin-gutter::after {
    content: '';
    position: absolute;
    top: calc(1lh / 2);
    bottom: calc(-1 * (var(--origin-beat-gap) + 1lh / 2));
    width: 1px;
    background: var(--border);
  }
  /* The oldest beat trails off rather than stopping at its dot, so the record
     reads as continuing behind the first entry. */
  .origin-row:last-child .origin-gutter::after {
    content: '';
    position: absolute;
    top: calc(1lh / 2);
    height: var(--origin-beat-gap);
    width: 1px;
    background: linear-gradient(to bottom, var(--border), transparent);
  }
  .origin-detail {
    color: var(--muted-foreground);
    line-height: 1.65;
  }
  .origin-marker {
    position: relative;
    display: block;
    width: 0.62em;
    height: 0.62em;
    border-radius: 9999px;
    border: 1.5px solid currentColor;
    background-color: var(--background);
    box-sizing: border-box;
    flex-shrink: 0;
  }
  .origin-row[data-default-active='true'],
  .origin-row[data-active='true'] {
    color: var(--foreground);
  }
  .origin-row[data-default-active='true'] .origin-marker,
  .origin-row[data-active='true'] .origin-marker {
    background-color: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 18%, transparent);
  }
  /* The link carries the phone tap minimum the landing page holds every link
     to, and the pill inside it draws at the height the row wants. Sizing the
     pill itself to 44px made it read as a button among log lines. */
  .origin-chip-hit {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    justify-content: center;
  }
  .origin-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 9999px;
    padding: 0.2rem 0.75rem;
    color: var(--muted-foreground);
  }
  .origin-chip-hit:hover .origin-chip {
    border-color: var(--accent);
    color: var(--foreground);
  }
  @media (prefers-reduced-motion: no-preference) {
    .origin-row,
    .origin-marker,
    .origin-chip {
      transition:
        color 150ms ease-out,
        background-color 150ms ease-out,
        border-color 150ms ease-out,
        box-shadow 200ms ease-out;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.origin-stage')
  const list = stage?.querySelector<HTMLOListElement>('.origin-list')
  if (stage && list) {
    const rows = Array.from(list.querySelectorAll<HTMLLIElement>('.origin-row'))
    const defaultIdx = Math.max(
      0,
      rows.findIndex((r) => r.dataset.defaultActive === 'true'),
    )
    let activeIdx = defaultIdx
    let walkTimer: number | null = null

    const setActive = (idx: number) => {
      rows[activeIdx]?.removeAttribute('data-active')
      rows[idx]?.setAttribute('data-active', 'true')
      activeIdx = idx
    }

    const cancelWalk = () => {
      if (walkTimer !== null) {
        window.clearTimeout(walkTimer)
        walkTimer = null
      }
    }

    rows[defaultIdx]?.removeAttribute('data-default-active')
    setActive(defaultIdx)

    for (const [i, row] of rows.entries()) {
      row.addEventListener('pointerenter', () => {
        cancelWalk()
        setActive(i)
      })
    }

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const baseDelay = 40
    const maxDelay = 160

    stage.addEventListener('pointerleave', () => {
      cancelWalk()
      if (reduce || activeIdx === defaultIdx) {
        setActive(defaultIdx)
        return
      }
      const startDistance = Math.abs(activeIdx - defaultIdx)
      const step = activeIdx > defaultIdx ? -1 : 1
      let stepsTaken = 0

      const scheduleNext = () => {
        const progress = stepsTaken / startDistance
        const delay = baseDelay + progress * progress * (maxDelay - baseDelay)
        walkTimer = window.setTimeout(() => {
          setActive(activeIdx + step)
          stepsTaken += 1
          if (activeIdx === defaultIdx) {
            walkTimer = null
          } else {
            scheduleNext()
          }
        }, delay)
      }

      scheduleNext()
    })
  }
</script>
